{
  "damage_type.dragonsurvival.frigid_breath": "Hàn Thở",
  "damage_type.dragonsurvival.icicle": "Băng Chui",
  "damage_type.dragonsurvival.shatter": "Bổ Toái",
  "dragon_ability.dragonsurvival.blizzard": "Bạo Tuyết",
  "dragon_ability.dragonsurvival.blizzard.desc": "■ Thở ra một cơn bão không khí đóng băng, khiến §2nước và dung nham đông cứng§7. Phun lên bề mặt sẽ §2phủ tuyết lên chúng§7 và §2dập tắt ngọn lửa§7.\n\n■ Dùng Bạo Tuyết lên thịt sẽ biến chúng thành phiên bản §2Lành Lạnh§7 bổ dưỡng hơn, và sẽ §2Gây Bỏng Lạnh§7 nếu chịu thêm phơi nhiễm.\n\n■ Năng lực này không gây sát thương trực tiếp. \n\n■ §fTầm§r§7 của nó phụ thuộc vào tuổi của rồng.",
  "dragon_ability.dragonsurvival.frigid_breath": "Hàn Sương Thở",
  "dragon_ability.dragonsurvival.frigid_breath.desc": "■ Phun ra một cơn lũy tuyết cùng mảnh băng, gây §c«Phong Hàn»§r lên kẻ địch, vừa gây sát thương vừa làm chậm chúng.\n\n■ §fTầm§r§7 của nó phụ thuộc vào tuổi của rồng.",
  "dragon_ability.dragonsurvival.ice_immunity": "Miễn Băng",
  "dragon_ability.dragonsurvival.ice_immunity.desc": "■ Rồng Băng Nguyên có §2miễn nhiễm bẩm sinh với sát thương đóng băng và hiệu ứng «Chậm»§r§7.",
  "dragon_ability.dragonsurvival.icicle": "Băng Giáo",
  "dragon_ability.dragonsurvival.icicle.desc": "■ Phóng ra một thanh giáo băng chính xác với tốc độ cực nhanh, gây §c«Phong Hàn»§r lên mục tiêu và các sinh vật gần đó.\n\n■ Nó cũng khiến rồng rơi khỏi không trung.",
  "dragon_ability.dragonsurvival.precise_hearing": "Tuệ Nhuệ Giác Quan",
  "dragon_ability.dragonsurvival.precise_hearing.desc": "■ Tập trung vào không gian xung quanh, khiến sinh vật gần đó §cphát quang§r xuyên qua tường..",
  "dragon_ability.dragonsurvival.shatter": "Bổ Toái",
  "dragon_ability.dragonsurvival.shatter.desc": "■ Phá vỡ lớp băng bao phủ kẻ địch §c«Bị Phong Hàn»§r lân cận, gây sát thương lớn và gỡ bỏ hiệu ứng.\n\n■ Băng chui cắm trong mặt đất sẽ vỡ tung, bắn ra những mảnh băng khắp khu vực xung quanh.",
  "dragon_ability.dragonsurvival.snow_sense": "Tuyết Giác",
  "dragon_ability.dragonsurvival.snow_sense.desc": "■ Là những kẻ săn mồi siêu phàm của miền cực khắc nghiệt, giác quan và thể lực của Rồng Băng Nguyên đã được thần thuật cường hóa.\n\n■ §8Năng lực này giúp loài của ngươi sinh tồn! Đừng gỡ bỏ trừ khi ngươi biết mình đang làm gì.",
  "dragon_ability.dragonsurvival.snowdrift": "Tuyết Phiêu",
  "dragon_ability.dragonsurvival.snowdrift.desc": "■ Đòn tấn công của ngươi gây §c«Phong Hàn»§r§7.",
  "dragon_ability.dragonsurvival.thick_ice": "Hậu Băng",
  "dragon_ability.dragonsurvival.thick_ice.desc": "■ Giảm khả năng bị tổn hại bởi nhiệt và làm giảm mức phạt giáp của ngươi.",
  "dragon_ability.dragonsurvival.tundra_athletics": "Băng Nguyên Cử Trình",
  "dragon_ability.dragonsurvival.tundra_athletics.desc": "■ Đứng trên bề mặt §fbăng§7 sẽ làm tăng §2tốc độ di chuyển§7 của ngươi.",
  "dragon_ability.dragonsurvival.tundra_claws_and_teeth": "Lợi Trảo Liêu Nhã",
  "dragon_ability.dragonsurvival.tundra_claws_and_teeth.desc": "■ Rồng Băng Nguyên gây nhiều §2sát thương cộng thêm§r§7 hơn với đòn cận chiến so với các loài rồng khác. Năng lực này mạnh hơn khi ngươi trưởng thành.",
  "dragon_ability.dragonsurvival.tundra_magic": "Băng Nguyên Ma Thuật",
  "dragon_ability.dragonsurvival.tundra_magic.desc": "■ Nâng cấp năng lực này sẽ tăng §2bể ma lực tối đa§r§7 và cho phép hồi ma lực khi đứng trên §fbăng§r§7 hoặc §ftuyết§r§7.\n\n■ §8Càng nhiều cấp, tốc độ hồi ma lực thụ động của ngươi càng cao.",
  "dragon_ability.dragonsurvival.tundra_spin": "Băng Nguyên Toàn Xoay",
  "dragon_ability.dragonsurvival.tundra_spin.desc": "■ Ngươi có thể §2xoay§r§7 xuyên qua §fkhông khí§r§7 và §fnước§r§7 để tăng tốc độ. Ngươi phải tới §fVùng End§r §7để học kỹ năng này.",
  "dragon_ability.dragonsurvival.tundra_wings": "Băng Nguyên Song Dực",
  "dragon_ability.dragonsurvival.tundra_wings.desc": "■ Rồng dùng §floi lơ lửng§r§7 để §2bay§r§7, nhưng hiếm khi sinh ra đã có năng lực ấy.",
  "dragon_penalty.dragonsurvival.heat_weakness": "Nóng Chảy Điểm",
  "dragon_penalty.dragonsurvival.heat_weakness.desc": "■ Bị §cchâm lửa§r quá lâu sẽ làm tan mạng lưới thủy tinh băng bên trong và làm suy yếu phép thuật trong 10 giây.\n\n■ Kỹ năng §2«Hậu Băng»§7 sẽ kéo dài thời gian chịu đốt trước khi hình phạt kích hoạt, và một §2Thủy Tinh Ngâm Nhiễm§7 hay hiệu ứng §2«Kháng Hỏa»§7 sẽ vô hiệu hóa hoàn toàn hình phạt.",
  "dragon_penalty.dragonsurvival.impact_weakness": "Mỏng Manh Thân Thể",
  "dragon_penalty.dragonsurvival.impact_weakness.desc": "■ Thân thể băng giá của ngươi thì §dmỏng manh§r§7. Ngươi chỉ nhận được §csự bảo vệ ít hơn từ giáp.§r\n\n■ Kỹ năng §2«Hậu Băng»§7 sẽ giúp ngươi giảm thiểu điều này.",
  "dragon_penalty.dragonsurvival.melting_point": "Hỏa Diễm Yếu Điểm",
  "dragon_penalty.dragonsurvival.melting_point.desc": "■ Ngươi nhận sát thương tăng đáng kể từ §clửa và dung nham§r.\n\n■ Kỹ năng §2«Hậu Băng»§7 sẽ giảm hình phạt này, còn một §2Thủy Tinh Ngâm Nhiễm§7 hay hiệu ứng §2«Kháng Hỏa»§7 sẽ vô hiệu hóa hoàn toàn.",
  "dragon_species.dragonsurvival.tundra_dragon": "Rồng Băng Nguyên",
  "dragon_species.dragonsurvival.tundra_dragon.locked": "§7■ §6Rồng Băng Nguyên§7 là một §f loài§7 vừa bền bỉ vừa giòn. Sức công năng tấn công của chúng vô cùng lớn, và chúng vận dụng thế lực của băng để §fcản trở§7 và §fhủy diệt§7 kẻ thù.\n\n§2■ Đặc điểm:§7 vuốt sắc hơn, thuật băng, di chuyển nhanh hơn trên băng và khối tuyết.\n§4■ Lời nguyền:§7 mỏng manh, lửa.\n\n§3■ Điều kiện mở khóa: §7\n1. Hoàn thành§6 Hướng Dẫn Sơ Cấp§7.§r",
  "dragon_species.dragonsurvival.tundra_dragon.altar.desc": "§7■ §6Rồng Băng Nguyên§7 là một §f loài§7 vừa bền bỉ vừa giòn. Sức công năng tấn công của chúng vô cùng lớn, và chúng vận dụng thế lực của băng để §fcản trở§7 và §fhủy diệt§7 kẻ thù.\n\n§2■ Đặc điểm:§7 vuốt sắc hơn, thuật băng, di chuyển nhanh hơn trên băng và khối tuyết.\n§4■ Lời nguyền:§7 mỏng manh, lửa.\n§6■ Thức Ăn:§r %s",
  "dragon_species.dragonsurvival.tundra_dragon.banner.desc": "§7■ §6Rồng Băng Nguyên§7 là một §f loài§7 vừa bền bỉ vừa giòn. Sức công năng tấn công của chúng vô cùng lớn, và chúng vận dụng thế lực của băng để §fcản trở§7 và §fhủy diệt§7 kẻ thù.\n\n§7■ Chúng chỉ ăn được tuyết và thịt, dù là §fsống§7 hay §fnướng§7. Bộ xương §fbăng§7 của ngươi thì §cmỏng manh§7 và dễ bị §cnhiệt§7 tấn công.§r",
