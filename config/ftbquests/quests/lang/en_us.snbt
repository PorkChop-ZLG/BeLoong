	quest.735C8B5A219C57AE.quest_desc: [
		"&a目标：学会使用技能，击杀1只铁傀儡"
		""
		"&6每种龙都有其专属技能，点击物品栏上方的&6技能信息&f。"
		"&6龙能携带4个&e主动技能&6，位于屏幕&e右下角&6。"
		"&6先按&d【R】&6键选择技能，再长按&d【C】&6键释放。"
		"&6使用技能要消耗&5法力&6，技能上方的小点点表示法力值。"
		"&6法力值&6随着&2经验等级&6提高而增加，技能伤害同理。"
		""
		"&c注意：如果法力耗尽，技能会消耗经验值！"
		"{@pagebreak}"
		"&6打开物品栏，点击最上方一排第二个的&a技能信息&6。"
		"&6可以看到从左往右有四列技能，下面依次讲解。"
		""
		"&a1: &d快捷栏&6，界面右下角的四个主动技能，可替换。"
		"&a2: &d主动技能&6，拖动到快捷栏替换，等级与经验相关。"
		"&a3: &d被动技能&6，点击右边的箭头可以升级，消耗经验。"
		"&a4: &d被动&d，&6代表每种龙的特性。"
		""
		"&c注意：按鼠标滚轮可以翻页，按shift查看技能详情！"
		"{image:kubejs:textures/task/dragon_skill.png width:100 height:80 align:center}"
	]
	quest.735C8B5A219C57AE.quest_subtitle: "学会使用龙族技能"
	quest.735C8B5A219C57AE.title: "龙语魔法"
	quest.7374FD45EAC02F8D.quest_desc: [
		"&6在&d天赐块&6顶部放置"
		""
		"&6一块&a雕刻月螟仙人掌果实&6即可召唤"
		""
		"防空型效用生物，只会将小部分空中敌对生物为攻击目标；"
		""
		"目前版本仅包括幻翼一种；"
		""
		"攻击生物时，其攻速极快，射程极远且伤害范围极大，但即便如此，它的攻击依旧无法伤及其它非空中生物；"
		""
		"周围没有陨石 / 上述目标时，天赐傀儡即使被其它生物攻击也不会进行反击。"
		""
		"当天赐傀儡处于地表，且当前天气为流星雨时；"
		""
		"天赐傀儡会直接在半空中射毁正在坠下的陨石，被射毁的陨石仍会产出相应的物品；"
		""
		"苦彗怕也会因为陨石被射毁而无法生成。"
	]
