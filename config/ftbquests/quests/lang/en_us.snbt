	quest.17A9978D7AFEA210.quest_desc: [
		"&l&d\"Moonvine Colossus\""
		"&6Health: &a3000"
		"&6Attack: &c???"
		"&6Armor: &712"
		""
		"&l&dSpawn"
		"&6The Moonvine Colossus spawns at the center endpoint of the &9Cursed Garden&6."
		"&6When not ignited, it has massive damage reduction,"
		"&6all incoming damage is forcibly reduced to 1."
		"&6All its damage comes from skills."
		""
		"&9Structure Compass: &b【Eternal Starlight】Cursed Garden&r"
		"{@pagebreak}"
		"&l&dGuide"
		"&cBring several buckets of lava and pour them under it."
		"Recommended: use a &cCave Dragon&r and continuously breathe flames."
		"Recommended: Hot Spring Stone Sword, Hot Spring Stone Scythe, Dragonflame Steel Sword,"
		"Recommended: Fire Aspect and Flame enchantments."
		""
		"&l&dSkills"
		"&l&eTenfold Ranged Burst"
		"Fires projectiles consecutively at the target, 10 times per cycle;"
		"Deals small-area AoE damage on hit, blockable by shields."
		"&l&eSummon Moonlight Thorns"
		"Summons 4–7 Moonlight Thorns in the target's direction;"
		"Each thorn grows in a straight line, dealing continuous damage;"
		"Targets are inflicted with Slowness I while standing on them (removed after leaving);"
		"The first thorn is shortest, the second is longer, and subsequent ones are longest;"
		"Visual rings during this skill are purely cosmetic;"
		"Moonlight Thorns disappear after a few seconds and can be avoided by jumping."
		"{@pagebreak}"
		"&l&eBurrow"
		"Its only movement method, burrowing underground to chase targets;"
		"While burrowing, it is invulnerable and cannot use other skills;"
		"It emerges to deal damage when catching up or when the duration ends."
		"&l&eMelee"
		"If targets are too close, it bites them, dealing damage."
		"&l&ePoison Mist"
		"After charging briefly, sprays poison mist for several seconds,"
		"dealing continuous damage and applying Poison I for 2 seconds."
		"&l&eWraith Skull Barrage"
		"Summons 8 wraith skulls around itself and launches them at targets;"
		"Deals AoE damage and applies Slowness I, Weakness I, Blindness, and Darkness;"
		"Often combined with Moonlight Thorns or Poison Mist. Be cautious."
	]
	quest.17A9978D7AFEA210.quest_subtitle: "★★★★"
