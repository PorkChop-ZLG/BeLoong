	quest.03B1663E1AEFE3E8.title: "Rise of the Lords: Infernal Dragon"
	quest.03DA2F2992CDD7DA.quest_desc: [
		"&l&dQliphoth「Chesed」"
		""
		"&7A strange creature born from sculk-corrupted stone."
		"&7Wields lightning magic."
		""
		"&aRecommended: &bSharpness Axe&6, &eEnchanted Golden Apples&6, &5Ender Pearls&6."
		""
		"&9The Chesed Arena&6 lies deep underground. Blocks cannot be placed or broken, and flying is disabled."
		""
		"&dAll attacks deal &ftrue damage&6. Armor is useless. Chesed cannot be hit directly; damage it by reflecting &blightning beams&6."
		""
		"&bStructure Compass: &9【Qliphoth】Chesed Arena&r"
		""
		"&c&l【Boss Guide on Next Page!】"
		""
		"{@pagebreak}"
		"&c&l「Chesed」Boss Guide:"
		""
		"&6Right-click the &9Chesed Summoner&6 in the center and read all skills, then start the fight."
		""
		"&dAt first, 4 &bChesed Crystals&6 and 3 &bBeam Reflectors&6 spawn. Break crystals to gain &bCharge&6, which blocks two beams. Lead beams to reflectors to deal 1 damage."
		""
		"&dPhase 2 starts below half health. A fatal skill depends on activated &bChesed Pillars&6. Destroy pillars to disable them."
		""
		"&dAfter defeat, drops &bChesed Trophy&6 and &bLightning Core&6. The core enhances weapons and may summon weapon phantoms."
	]
	quest.03DA2F2992CDD7DA.quest_subtitle: "★★★★★★"
