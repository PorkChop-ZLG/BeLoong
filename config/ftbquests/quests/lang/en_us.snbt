	quest.0FC068CD405DBBD4.quest_desc: [
		"&l&dQliphoth「Geburah」"
		""
		"&7All are born with sin, yet few are judged."
		"&7Thus, it was forged — an eternal judge."
		"&7But can a sinner judge others fairly?"
		"&7Time has passed, and none know the answer."
		""
		"&aTip: Prepare ranged weapons ❎ Increase HP ✅"
		""
		"&9The Geburah Arena is located on the outer End islands. Built of Justicestone, it cannot be destroyed."
		""
		"&d「Geburah」&6displays your current &eCrimes&6. Flying and fleeing also count! Accumulate &25 Crimes&6 to be &cinstantly executed!"
		"&d「Geburah」&6cannot be attacked directly, but it can also commit crimes! Only by killing will it take damage!"
		""
		"&bStructure Compass: &9[Qliphoth] Geburah Arena &r"
		""
		"&c&l[BOSS Guide on Next Page!]"
		""
		"{@pagebreak}"
		"&c&l「Geburah」BOSS Guide:"
		""
		"&6Before challenging, right-click the &eRest Point&6 outside to set your spawn."
		"&6Right-click the &9Geburah Summoner&6 in the arena center, read each skill, then click &9Start Boss Fight."
		""
		"&d「Geburah」&6summons &zJudgment Birds&6 to judge everyone, including itself!"
		"&d「Geburah」&6places &eBinding Traps&6. When a &zJudgment Bird&6 is trapped, lure &ePurification Lasers&6 to kill it."
		"&d「Geburah」&6gains 1 Crime for killing a Judgment Bird. At &25 Crimes&6 it enters Phase 2; at &210 Crimes&6 it is executed by the &eHammer of Justice&6 — the only way to defeat it."
		""
		"&7&oThis is probably the most complex BOSS."
	]
	quest.0FC068CD405DBBD4.quest_subtitle: "★★★★★★★"
	quest.0FC068CD405DBBD4.title: "Qliphoth: Geburah"
	quest.0FFBB91C7CFBD6BC.title: "Challenge: Igloo"
	quest.10001CCE328F12E9.quest_desc: [
		"&bOracle Orb&6 is used to activate the &eStarlight Portal&6."
		"&6Hold and &d[Right-click]&6 the &eRuned Voidstone&6 to open it."
		"&6You can also build a portal with Runed Voidstone,"
		"&6using &e8 blocks&6 in a &adiamond&6 frame as shown on the left."
		""
		"&6Defeat the &eGatekeeper&6 to obtain a &bLoot Bag&6 containing an &bOracle Orb&6."
		""
		"&7&oAn all-knowing mysterious orb used on portal frames;"
		"&7&oIt can also view your sigils and cast their spells."
	]
	quest.10001CCE328F12E9.quest_subtitle: "Open the Starlight Portal"
	quest.1011C97DAE40FD1B.quest_desc: [
		"&6During meteor showers, purple-trail meteors fall in straight lines, damaging nearby mobs;"
		""
		"&6Resource meteors may also fall, causing powerful explosions (no terrain damage);"
		""
		"&6After impact, they may drop 8 Raw Celestial Ores or generate Nebulite and Raw Celestial Blocks;"
		""
		"&6Meteors may also spawn Bitter Comets on impact;"
		""
		"&6Survival players can launch Starcaller Rockets to trigger meteor showers;"
		""
		"&6This is the only way to obtain Nebulite and Raw Celestial Ore. Usually 1–4 meteors fall per event."
	]
	quest.1011C97DAE40FD1B.quest_subtitle: "Meteor showers are rare, short special weather in the Starlight Dimension."
	quest.1011C97DAE40FD1B.title: "Let’s Watch the Meteor Shower"
