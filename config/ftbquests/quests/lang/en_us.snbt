	quest.7EB346A1790BD94B.title: "公会城堡"
	quest.7F3860516EB20F18.quest_desc: [
		"&d&l「Geburah」"
		"{ \"text\": \"点击跳转到BOSS介绍\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0FC068CD405DBBD4\" } }"
		""
		"&6为了消灭末地的龙族，人类铸造了威力恐怖的天平："
		"&6它的本体坚不可摧，它的火力无与伦比；"
		"&6它痛恨飞行的龙族，它抹杀空中的敌人；"
		"&6它会认为万物有罪，它用激光主持公道；"
		"&6它是永恒的审判官，它是龙族的刽子手。"
	]
	quest.7F3860516EB20F18.quest_subtitle: "击败「Geburah」"
