    quest.34157C6ADA0E26B8.quest_desc: [
        "&aObjective: Enter The Undergarden"
        ""
        "&6This modpack has completely revamped &2The Undergarden&6."
        "&6The &2Corruption &6from Terraria has spread here."
        "&6The once vibrant world has now degenerated into the rotten Malkuth."
        "&6Follow the quest guidance, explore this deep, dark dimension,"
        "&6slay the fully mutated monsters, challenge bosses from Terraria,"
        "&6and try to unravel the mysteries behind it all."
    ]
