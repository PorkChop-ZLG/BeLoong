	quest.45865A0F5D63488F.quest_desc: [
		"&l&dQliphoth「Malkuth」"
		""
		"&7A king who once loved his people, ruling a prosperous kingdom,"
		"&7but due to blind generosity, he forfeited his Malkuth."
		""
		"&aTip: Challenge him at night&7&o (because the sky is beautiful)"
		""
		"&9The Malkuth Arena &6is located on a fiery and icy island in the deep ocean. The arena is controlled by Malkuth; you cannot break or place blocks."
		""
		"&d「Malkuth」's &6attacks are divided into &bIce &6and &cFire &6attributes. On the island, your crosshair will have a circle showing your current weakness attribute."
		"&d「Malkuth」&6 himself cannot be attacked directly. Damage can only be dealt during &eArtillery Duels &6by firing the &eMalkuth Cannon &6at him."
		""
		"&bStructure Compass: &9【Qliphoth】Malkuth Arena &r"
		""
		"&c&l【BOSS STRATEGY ON NEXT PAGE!】"
		""
		"{@pagebreak}"
		"&c&l「Malkuth」BOSS Strategy:"
		""
		"&6Right-click the &9Malkuth Boss Generator &6in the center of the &9Malkuth Arena&6, read each skill description carefully, then click &9Start Boss Fight &6in the top-left corner."
	]
	quest.45865A0F5D63488F.quest_subtitle: "★★★★★★"
	quest.45865A0F5D63488F.title: "Qliphoth: Malkuth"
	quest.459C37FAE369EFF4.title: "Challenge: Blimp"
