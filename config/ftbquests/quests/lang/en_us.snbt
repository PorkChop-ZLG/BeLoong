    quest.4A99D680EDD3652F.title: "&4Tianshu"
    quest.4AC69031BAEF29B0.quest_desc: [
        "&6The Scroll Scribing Table &ris used to scribe &eSpell Scrolls &rinto &5Spell Books&r."
        ""
        "Place the &5Spell Book &rin the top-left slot, and the &eSpell Scroll &rin the bottom-left slot."
        ""
        "The box on the right shows the &6Spell Slots&r. Left-click to select the slot you want to scribe to."
        ""
        "Finally, click the ink button in the center to scribe the spell."
    ]
    quest.4AC69031BAEF29B0.quest_subtitle: "The Origin of Iron's Spells"
    quest.4AE7B82C02B26C16.quest_desc: [
        "&aObjective: Train a Dragon Forger and buy the Key of Radiance from them."
        ""
