    quest.434D3A47067493D8.quest_desc: [
        "The once most glorious knights have now decayed. They are closely linked to the arsenide surrounding the forest center. Their souls cannot rest, guarding this tomb day and night to prevent intruders."
        ""
        "&cNote: Using magic attacks against Phantom Knights may not register as a kill. Please use physical attacks!"
    ]
    quest.434D3A47067493D8.quest_subtitle: "The ancient and powerful knight civilization was once the most glorious in the Twilight Forest, but now they have declined."
    quest.434D3A47067493D8.title: "&8Are these ghosts?"
    quest.4358E3E5AC4CD8BF.quest_desc: [
        "&aObjective: Craft a Catalyst"
        ""
        "&2The Undergarden &6is a dark underground dimension located deep below the bedrock of the Overworld."
        "&6The flora there has adapted to the dark and can grow without sunlight."
        "&6Strange creatures call it home, and various Rotspawn from a chaotic and dark realm"
        "&6spread themselves everywhere to invade this place..."
        ""
        "&6Build a Nether portal-shaped frame using any &eStone Bricks&6."
        "&6Then &dright-click &6the bottom of the frame with a &eCatalyst &6to light it."
        "&6This creates a &2The Undergarden &6portal."
        ""
        "&c(Recipe modified, requires materials from Eternal Starlight)"
    ]
    quest.4358E3E5AC4CD8BF.quest_subtitle: "The dark Malkuth beneath the bedrock"
    quest.4358E3E5AC4CD8BF.title: "&2&lMain Quest: The Undergarden"
    quest.4385F7925457C289.title: "Spell Book T1"
    quest.439CE3D219AEA946.quest_desc: [
        "&aObjective: Delve deep underground in The Undergarden and enter the Abyss"
        ""
        "&5The Abyss &6accumulates all the filth of &2The Undergarden&6."
        "&6When the Corruption from Terraria invaded, it became a paradise of decay."
        "&6In &5the Abyss&6, you will accumulate &eRot Infection&6. When full, you start losing health."
        "&eRot Infection &6is the status bar above your hunger bar."
        "&6Eating &eRotbane Nodules &6and &eRotbane Clumps &6can cleanse the rot."
    ]
    quest.439CE3D219AEA946.quest_subtitle: "The Arbiter of the Decay Domain"
    quest.439CE3D219AEA946.title: "Rot Value"
    quest.4461A4B09511AFD5.quest_desc: [
        "&9Attribute: &6Wind, Yin-Yang"
        "&2Traits: &6Fast flight speed, immune to fall damage"
        "&4Weakness: &6Prone to suffocation, suffers Blindness and Wither below Y=0"
