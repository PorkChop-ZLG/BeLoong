    quest.18189EEE0D9A4F88.quest_desc: [
        "&aGoal: Forge the Lightbringer Chestplate, Boots of Swiftness, and Hell Scythe"
        ""
        "Congratulations. Your journey as a mage is nearing its end."
        ""
        "From a clueless apprentice,"
        ""
        "you have grown step by step"
        ""
        "into a great mage protecting humanity."
        ""
        "After countless trials, you defeated the Branded One"
        ""
        "and became the new Mage King."
        ""
        "But your adventure is far from over."
        ""
        "More spells await your discovery."
        ""
        "Now, wear the gifts of the Lightbringer and face new challenges!"
    ]
