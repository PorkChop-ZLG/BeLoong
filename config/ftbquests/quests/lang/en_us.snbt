	quest.02B96CE03E4B8FF7.title: "Observe: Sculk Shrieker"
	quest.02EE21851AD77A5F.quest_desc: [
		"&6In the mysterious Starlight Dimension, ancient mages created the Starlight Golem using powerful Star Cores and indestructible Starsteel to resist the darkness. It can control starlight energy, firing blades of light that deal massive damage, and possesses strong defenses such as anti-TP and health locking. Corrupted by dark forces, it has now gone berserk and become a terrifying ruler of the dimension."
		"{ \"text\": \"Click to view Boss Guide\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6E02B2425A8EAB67\" } }"
	]
	quest.02EE21851AD77A5F.quest_subtitle: "Creation of an Ancient Civilization"
	quest.02EE21851AD77A5F.title: "Starlight Golem"
