quest.2A5E822D66F0BEA1.quest_desc: [
    "&l&7Iron&5's &6Spells &5and &6Spellbooks&r&o&e (Iron Magic)"
    ""
    "&5Iron Magic&6 is a mod inspired by classic RPGs."
    ""
    "&6You can fight hostile wizards, trade with neutral wizards,"
    "&6raid naturally generated structures, explore dungeons, gather resources,"
    "&6seek powerful magical items to gain and refine magical power."
    "&6Ultimately defeat the powerful &4King of the Dead&6 and &cPrimordial Flamebearer&6."
    ""
    "&6This modpack adds many Iron Magic addons,"
    "&6including cute &aFamiliars&6, Chinese-style &dEastern Mysticism&6,"
    "&cCataclysm&6 linked spellbooks, &bGTBC&6 spellbooks,"
    "&6and the dark side of your inner self: &5Shadow Doppelganger"
]
quest.2A5E822D66F0BEA1.quest_subtitle: "The Path of a Wizard's Growth"
quest.2A5E822D66F0BEA1.title: "&e&lExtra: Iron Magic"
quest.2A767F024C8A36EC.quest_desc: [
    "&aObjective: Obtain Fire Dragon Blood"
    ""
    "&cFire Dragon Scale + Glass Bottle = Fire Dragon Blood (Dragonfire Forge)"
    "&cCrimson Fat Ingot + Fire Dragon Blood = Hot Spring Stone Ingot (Dragonfire Forge)"
]
