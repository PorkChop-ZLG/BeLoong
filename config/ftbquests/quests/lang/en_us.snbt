	quest.02660EF9A8CDA757.quest_desc: [
		"&aObjective: Defeat the Ender Dragon"
		""
		"&dAfter the Ender Dragon&6 is slain, it drops massive loot and a mysterious pool appears."
		""
		"&6At this time, you have two choices:"
		"&61. Find the &5End Portal&6 beside the chest and return to the &2Overworld&6;"
		"&62. Throw a &dDragon Egg&6 into the pool and travel to the &3Twilight Forest&6."
	]
