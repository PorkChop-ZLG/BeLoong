    quest.32252DED7BE99D29.quest_desc: [
        "&eThe Gatekeeper &6is the first boss of &dEternal Starlight&6,"
        "&6and also the final boss of the Twilight Forest."
        "&6While meditating, the &eGatekeeper &6enters an idle state, immune to all attacks."
        "{ \"text\": \"Click to jump to boss strategy\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"28625E49F473135B\" } }"
        ""
        "&6After players successfully defeat the &eGatekeeper&6, he will drop a &bLoot Bag&6,"
        "&6and at the same time unlock a &eTrading System&6, with the currency being &eStarlight Coins&6."
        "&d【Right-click】 &6to open the &bLoot Bag&6 and obtain a &bSeer Orb&6."
        "&bThe Seer Orb &6is used to activate the Starlight Portal."
        ""
        "&7&oNo one knows where the Starlight people eventually went; details about this race have become blurred."
        "&7&oAs the Chaotic Fissures across the Overworld gradually closed, explorers sealed the power once held within the fissures into crystal orbs, guarding them strictly to ensure only the brave and just could enter."
    ]
    quest.32252DED7BE99D29.quest_subtitle: "Defeat the Gatekeeper"
    quest.32252DED7BE99D29.title: "Gatekeeper"
    quest.32499F89EEAA2C31.quest_desc: [
