	quest.7082701EBE593912.quest_desc: [
		"&dEternal Starlight &6adds a mysterious Starlight dimension."
		"&6It features &28 &6unique biomes with distinct ecosystems,"
		"&6numerous interesting creatures, and various special equipment,"
		"&6as well as &23 &6new bosses to challenge."
		""
		"&6To reach the &dStarlight Dimension&6, you must first find the &eGatekeeper&6."
		"&6Locate &ePortal Ruins &6across the &aOverworld&6."
		"&6At the top of the Portal Ruins is a &eStarlight Portal &6made of &eGlyphstone&6."
		"&6A &eGatekeeper &6sits beside the portal; you must pass his trial."
		"{ \"text\": \"Click to jump to Gatekeeper introduction\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"32252DED7BE99D29\" } }"
		""
		"&6In this modpack, find the &eFinal Castle &6at the end of the &3Twilight Forest&6."
		"&6At the top of the castle lies the &dFinal Flower Garden&6, containing four activated Starlight Portals."
		""
		"&9Structure Compass: &b【Eternal Starlight】Portal Ruins"
	]
	quest.7082701EBE593912.quest_subtitle: "A mysterious Starlight-themed dimension"
	quest.7082701EBE593912.title: "&d&lMain Quest: Eternal Starlight"
