	quest.5E2F36A14E2F1879.quest_desc: [
		"&a目标：击败克苏鲁之眼，获得克苏鲁护盾"
		""
		"&2The Undergarden&6的地底，是永无天日的&5邃渊&6。"
		"&6邃渊内，潜藏着无数邪祟与亡魂，无人敢轻易踏足。"
		"&6据说，不可名状的克苏鲁将它的爪牙伸入此处，"
		"&6洁白的骨掌，托举着一颗血淋淋的眼球。"
		"&6找到&e可疑眼球&6，揭开克苏鲁的神秘面纱吧。"
		""
		"&9结构罗盘：&b【The Undergarden】克苏鲁之眼&r"
	]
	quest.5E2F36A14E2F1879.quest_subtitle: "击败克苏鲁之眼"
