	quest.7F3860516EB20F18.quest_desc: [
		"&d&l「Geburah」"
		"{ \"text\": \"Click to jump to boss introduction\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0FC068CD405DBBD4\" } }"
		""
		"&6To eliminate the dragons in The End, humanity forged a terrifyingly powerful balance:"
		"&6Its body is indestructible, its firepower unparalleled;"
		"&6It hates flying dragons, it erases airborne enemies;"
		"&6It deems all things guilty, it dispenses justice with lasers;"
		"&6It is the eternal inquisitor, it is the executioner of dragons."
	]
