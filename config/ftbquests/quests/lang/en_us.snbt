	quest.70F041A9AA323CCD.quest_desc: ["&cCongratulations on completing the Cave Dragon's path of growth!"]
	quest.71356A8881052F9A.quest_desc: [
		"&eThe Transmog Table &6can change the appearance of items."
		"&6For example, you can make a Diamond Sword look like a Wooden Sword for a surprise."
		"&6First, charge it with &5Amethyst Shards&6; one shard provides 3 charges."
		"&6Place the item whose appearance you want to change in the &eleft slot&6,"
		"&6and the template item in the &eright slot&6."
		"&6Transmogrification only changes the appearance of &nheld items and worn armor&r&6,"
		"&6not the appearance of placed blocks."
	]
	quest.71356A8881052F9A.quest_subtitle: "Item Disguise"
