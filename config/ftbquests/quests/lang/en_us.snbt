	quest.4631FD4DF4CFBC9F.quest_desc: [
		"&6A variant of the Creeper. When not attacked, it will not attack or move."
		""
		"&1When attacked: &6It starts rolling and chasing the target, while beginning to detonate itself (flashing white)."
		""
		"&aCompared to a normal Creeper:"
		""
		"&6The Heavenly Creeper's detonation has two phases."
		""
		"&dChasing Phase: &6Similar to a normal Creeper, but it takes longer to fully detonate, and the target needs to get much farther away to cancel the detonation."
		""
		"&5Ascension Phase: &6After the chasing phase, the Heavenly Creeper will spiral upwards for a few seconds before completely self-destructing."
		""
		"&6During the chasing phase, it can perform melee attacks on contacted targets (can be blocked by shields)."
		""
		"&6A Heavenly Creeper in the ascension phase cannot cancel its detonation. Because it's too high off the ground, the damage to players and the terrain is somewhat reduced."
		""
		"&6The self-destruction can destroy terrain and items, and can be blocked by a shield."
	]
	quest.4631FD4DF4CFBC9F.title: "Heavenly Creeper"
	quest.4633599C0B5F87C4.quest_desc: [
		"&aObjective: Grow to the Arch Dragon stage and defeat the Dark Doppelganger"
		""
		"&6The final trial is to confront the &5darkness &6within yourself and transcend!"
		"{ \"text\": \"Click to jump to boss introduction\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"11FC2E4D6E6B0D93\" } }"
