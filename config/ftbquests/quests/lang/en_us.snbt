	quest.465680AFE754AEAD.quest_desc: [
		"&aObjective: Observe the Boss Respawn Cage for 5 seconds"
		""
		"&eBoss Respawn Cages &6are items from the new &cCataclysm &6mod used to resurrect bosses."
		"&6Observe the &atop &6of the respawn cage; it will show the &aresurrection item &6needed to revive the boss."
		"&6Hold the resurrection item and &d【Right-click】 &6the cage to revive the boss."
		""
		"&6Items required to revive bosses:"
		"&bNetherite Monstrosity - Eye of the Monstrosity"
		"&bEnder Guardian - Eye of the Void"
		"&bThe Harbinger - Eye of the Mechanicum"
		"&bAncient Remnant - Eye of the Desert"
		"&bScylla - Eye of the Storm"
		"&bKing Slime - Slime Crown"
		"&bEye of Cthulhu - Suspicious Eye"
		"&bBrain of Cthulhu - Bloody Spine"
		"&bEater of Worlds - Worm Food"
		"&bQueen Bee - Abominable Bee"
		"&bSkeleton King - Forgotten Ingot"
		""
		"&7&oFor technical reasons, Terra bosses do not spawn Boss Respawn Cages upon death."
	]
	quest.465680AFE754AEAD.quest_subtitle: "Summoning Method for Terra Bosses"
	quest.465680AFE754AEAD.title: "Boss Respawn Cage"
