	quest.3A606C2453D06AFF.quest_desc: [
		"&aObjective: Observe the Ritual Core for 5 seconds"
		""
		"&eIn the middle of the Origin Island &6is an &eAltar&6."
		"&eFamiliar Statues &6are placed around the &eAltar&6, with the &eAltar Core &6at its center."
		"&6Use &dEMI &6to look up the recipes for altar crafting."
		"&d【Right-click】 &6to place the &ecentral &6item of the recipe onto the &eAltar Core&6."
		"&d【Right-click】 &6to place the &esurrounding &6items of the recipe onto the &efour statues&6."
		"&6Except for the central item, the surrounding items &ahave no placement order&6."
		""
		""
		"{image:kubejs:textures/task/ritual_core.png width:200 height:160 align:center}"
	]
