	quest.6C896BDFB4BBB4E4.quest_desc: [
		"&aObjective: Learn to use FTB Chunks"
		""
		"&aFTB Chunks &6can protect your land from being destroyed by other players."
		"&6Even in single-player, it can be used as a &achunk loader&6."
		""
		"&6Press &d【E】 &6to open your inventory, click the dark green &2Claim Chunks &6in the top-left corner."
		"&6You will see a map overlaid with a grid, where each square represents a &2chunk&6."
		"&d【Left-click】 &6on a chunk on the map; the &2color change &6indicates a successful claim."
		"&d【Right-click】 &6on a claimed chunk to unclaim it."
		"&d【Shift+Left-click】 &6on a claimed chunk; &2diagonal lines &6appear,"
		"&6indicating it is force-loaded. Force-loading only works &2while a team member is online&6."
		"&d【Shift+Right-click】 &6on a force-loaded chunk to disable force-loading."
		""
		"&6To give other players land permissions, either join the same team,"
		"&6or add them as allies. The more players in your team, the more chunks you can claim."
		""
		"{@pagebreak}"
		"&6The &aminimap &6function of FTB Chunks has been disabled and cannot be restored."
		"&6Press &d【,】 &6to open the FTB Chunks world map &7(similar to Xaero's map)."
		"&6You can view &2other players' claimed land &6and activated &2Waystones&6."
	]
	quest.6C896BDFB4BBB4E4.quest_subtitle: "FTB Chunks Usage Tutorial"
	quest.6C896BDFB4BBB4E4.title: "Claiming Chunks and Force-Loading"
