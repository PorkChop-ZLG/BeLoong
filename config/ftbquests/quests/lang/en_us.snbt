    quest.316AFA91B0365E94.quest_desc: [
        "The castle towering over the Thornlands has long been left unvisited."
        ""
        "This castle once opened a portal to another world,"
        ""
        "developing wondrous technologies, but now lies in ruin."
        ""
        "At the top of the castle lies a serene and beautiful flower garden."
        ""
        "The garden is home to a Gatekeeper, who stays here alone,"
        ""
        "guarding the gateway to the Starlight dimension."
    ]
    quest.316AFA91B0365E94.quest_subtitle: "【Chapter II Concluded】"
