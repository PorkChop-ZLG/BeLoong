	quest.6E5594142D1F7454.quest_subtitle: "苏打清酒"
	quest.6EA867B07E184273.quest_desc: [
		"&6在久远之前，月藤一族曾是Eternal Starlight维度的守护者，以月藤之力维持维度平衡。但一场突如其来的黑暗风暴侵袭，吞噬了大部分月藤，仅存的月藤吸收过量混乱魔力，幻化成恐怖的月藤巨物。它能操控坚韧藤条攻击，还能释放月光诅咒，如今已成为维度中令人胆寒的强大存在 。"
		"{ \"text\": \"点击跳转到BOSS攻略\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"17A9978D7AFEA210\" } }"
	]
