	quest.7BA915DE214AD00A.quest_desc: [
		"&a目标：获得手稿"
		""
		"&e手稿&6用于在&e手稿誊写桌&6解锁异兽手记的章节。"
		"&6手稿可以在Ice and Fire的结构的宝箱中找到，无法合成。"
		""
		"&7&o“这个次元相当容易找到的材料，上面铭写着一些古代知识。”——探险家笔记•异兽之旅"
	]
	quest.7BA915DE214AD00A.quest_subtitle: "一位冒险家的传奇经历"
	quest.7BB8A9EB27C99160.quest_desc: [
		"&a目标：合成野火灯笼"
		""
		"&e野火灯笼&6可以照亮周围的一大片区域，"
		"&6范围是半径为&216&6的球形。"
		"&6野火灯笼会检测周围半径为 16 格的球中各个方块的亮度，若某方块的亮度小于 7，野火灯笼会尝试在其周围放置亮度为 11 的隐形光源。这可能会使其它模组的功能性方块、多方块结构等失效。"
	]
	quest.7BB8A9EB27C99160.quest_subtitle: "放置隐形光影"
	quest.7BBFEA3573C09A67.title: "挑战：独眼巨人海湾"
	quest.7BEEE28B8865648E.quest_desc: [
		"&a目标：获得异兽手记"
		""
		"&e异兽手记&6是&b冰&c火&7传说&6的新手指引。"
		"&6收集&e手稿&6，然后用&e手稿誊写台&6解锁章节，"
		"&6从而了解关于Ice and Fire模组的各种生物和设定。"
		"&6本整合包使用&b冰&c火&7传说&a社区版&6，由&d冰火使者&6负责维护。"
		""
		"&c（配方已修改，需要远古龙尘）"
		""
		"&7&o“用手稿编写出来的书籍，相当于一种指导书，指导着任何来到这个次元的冒险者的方向。”"
		"&7&o“虽然不知道手稿的编写者是谁，但他为这个次元的探索做出了极大贡献。”——探险家笔记•异兽之旅"
	]
	quest.7BEEE28B8865648E.quest_subtitle: "龙族的复兴之路"
	quest.7BEEE28B8865648E.title: "&e&l番外：Ice and Fire"
