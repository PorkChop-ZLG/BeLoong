    quest.3DB21E73BA8C8682.quest_desc: [
        "&a&lUsage Tutorial:"
        "Step 1: Prepare the &dimage &dyou want to project into the world."
        "Step 2: Upload the image to an image hosting website and get the URL link."
        "Recommended: &ehttps://www.imgurl.org/vip/manage/upload&e"
        "Step 3: Hold the slide &rright-click, paste the URL link into the slide. You can see the slide's name change to something like"
        "&a1234567890.jpg&a"
        "This means the image was successfully uploaded."
        "Step 4: Right-click the projector, place the slide into the slot on the lower left side of the projector. Activate the projector with a &4Redstone signal&4&f to start projecting the slide&f"
        "Tip: Do not change the default parameter FFFFFFFF on the right; it will cause the slide to &4fail to project&4"
        "&oYou can freely adjust the size and position of the slide&o"
        ""
        "&7&oYou can upload short GIFs and video clips as well&r"
    ]
    quest.3DB21E73BA8C8682.quest_subtitle: "Project Any Image"
    quest.3DF3F67A1FEA8AFE.quest_subtitle: "Isn't this a bit cruel"
    quest.3DF3F67A1FEA8AFE.title: "Obtain P Points"
