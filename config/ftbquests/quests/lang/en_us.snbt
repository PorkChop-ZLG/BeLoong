    quest.0148D8DF96431BD6.quest_desc: [
        "&aObjective: Obtain a Brush and collect Dragon Scales"
        ""
        "&eBrushes&6 can clean the scales of &bIce&c and &7Fire&6 dragons to obtain &eDragon Scales&6."
        "&6First, hatch your own dragon using an &eIce and Fire Dragon Egg&6,"
        "&6then wait until it grows to at least &23&6, and you can brush its scales."
        "&eTier 3 Dragons&6 can be brushed up to &a3 times"
        "&eTier 4 Dragons&6 can be brushed up to &a4 times"
        "&eTier 5 Dragons&6 can be brushed up to &a5 times"
        "&6Each brushing drops &a1–2 items"
    ]
