	quest.61841B2C10B08D91.quest_desc: [
		"&aObjective: Briefly describe the task objective in green on the first line."
		""
		"&6Main text uses orange. Leave a blank line below the objective. Use &egold &6for emphasis."
		"&6If the task objective is an item, you don't need to fill in a title or icon, but you must write a subtitle."
		"&6Subtitles can be fun or describe the task requirements. Leave a blank line after the description."
		"&d【Keybindings】&6use pink brackets. Default task reward is &2100 XP&r."
		"{ \"text\": \"Use green for clickable links. Please copy this text and modify it.\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"038BE99D4FE3442D\" } }"
		""
		"&9Structure Compass: &bDark blue prefix, light blue text&r"
		"&2Nature's Compass: &aDark green prefix, light green text&r"
		""
		"&cNote: Use red for important notes, with a blank line above."
		""
		"&c(Recipe modified - use red and parentheses, place on the last line)"
		""
		""
		"&o&7Use light gray italics for comments or remarks, placed at the very bottom."
		"{@pagebreak}"
		"&2&l【Backstory】&rBold green brackets, must be placed on a new page."
		"&7Story text in light gray."
		""
		"备用符号："
		"① ② ③ ④ ⑤ ⑥ ⑦ ⑧ ⑨ ⑩"
		"⑪ ⑫ ⑬ ⑭ ⑮ ⑯ ⑰ ⑱ ⑲ ⑳"
		""
		"Difficulty Rating:"
		"★★★☆☆☆"
	]
