	quest.7BA915DE214AD00A.quest_desc: [
		"&aObjective: Obtain Manuscripts"
		""
		"&eManuscripts &6are used on a &eManuscript Scribing Table &6to unlock chapters in the Bestiary."
		"&6Manuscripts can be found in chests within Ice and Fire structures and cannot be crafted. "
		""
		"&7&o\"Materials that are relatively easy to find in this dimension, inscribed with some ancient knowledge.\" — Explorer's Notes: Journey of Beasts"
	]
	quest.7BA915DE214AD00A.quest_subtitle: "A Legendary Adventurer's Tale"
	quest.7BB8A9EB27C99160.quest_desc: [
		"&aObjective: Craft a Wildfire Lantern"
		""
		"&eWildfire Lanterns &6can illuminate a large area around them,"
		"&6with a spherical range of radius &216&6."
		"&6The Wildfire Lantern checks the light level of blocks within a 16-block radius sphere. If a block's light level is below 7, the Wildfire Lantern attempts to place an invisible light source with light level 11 near it. This may cause functional blocks or multiblock structures from other mods to malfunction."
	]
	quest.7BB8A9EB27C99160.quest_subtitle: "Places Invisible Light Sources"
	quest.7BBFEA3573C09A67.title: "Challenge: Cyclops Cove"
	quest.7BEEE28B8865648E.quest_desc: [
		"&aObjective: Obtain the Bestiary"
		""
		"&eThe Bestiary &6is the beginner's guide for &bIce &c& Fire. "
		"&6Collect &eManuscripts &6and use a &eManuscript Scribing Table &6to unlock chapters,"
		"&6learning about the various creatures and lore of the Ice and Fire mod."
		"&6This modpack uses &bIce &c& Fire &aCommunity Edition&6, maintained by &dIAFEnvoy&6."
		""
		"&c(Recipe modified, requires Ancient Dragon Dust)"
		""
		"&7&o\"A book compiled from manuscripts, serving as a guide for any adventurer arriving in this dimension.\""
		"&7&o\"Though the author of the manuscripts is unknown, they have made a great contribution to exploring this dimension.\" — Explorer's Notes: Journey of Beasts"
	]
