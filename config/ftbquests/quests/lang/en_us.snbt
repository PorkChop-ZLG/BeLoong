    quest.3F053183F9C244AD.quest_desc: [
        "&aObjective: Find the castle in the Nether"
        ""
        "A &6Castle &rburied in the Nether, forged from Deepslate and Blackstone."
        ""
        "Bookshelves made of Azalea wood fill the halls, with stacks of books scattered on the floor."
        ""
        "Ancient Knights clad in heavy armor guard this place, protecting the world's secrets."
        ""
        "At the top of the castle is set a &cSoulfire Rune&r, with the faint echo of bells in the air."
        ""
        "&9Structure Compass: &b【Iron's Spells 'n Spellbooks】Castle"
    ]
    quest.3F053183F9C244AD.quest_subtitle: "The Crystallized Wisdom of an Ancient Civilization"
    quest.3F053183F9C244AD.title: "Castle"
    quest.3FB2C999F046AAE3.quest_desc: [
        "&aObjective: Use Obsidian to build a Nether Portal and enter the Nether.&r"
        ""
        "The Nether is a land of treasure, rich with magical materials."
        ""
        "But with opportunity comes danger. The Nether is filled with Cataclysm structures,"
        ""
        "where powerful bosses slumber. Do not challenge them lightly."
    ]
    quest.3FB2C999F046AAE3.quest_subtitle: "The Crimson has spread to the Nether"
    quest.3FB2C999F046AAE3.title: "Crimson Nether"
    quest.3FC2BE2D5BDCA2AF.quest_desc: [
        "&aObjective: Use a Dragon Soul to store your dragon form."
        ""
        "&6Congratulations, you have reached the end of the path. Dragon Survival is drawing to a close."
        "&6Hold an &dAether Dragon Soul &6and long-press right-click to &ereturn to mortal form&6."
        "&6Within the Dragon Soul are recorded the memories of your journey,汇聚着龙族的能力."
        "&6You can gift it to others, or keep it safe;"
        "&6Finally, jump into the End Portal in the &eInheritance Grounds &6and embark on a new journey!"
    ]
    quest.3FC2BE2D5BDCA2AF.quest_subtitle: "【Chapter I Concluded】"
    quest.3FC2BE2D5BDCA2AF.title: "&6&lDragon Soul Inheritance"
    quest.403F4499E19370C1.quest_desc: [
        "&6The Mino++ Game Table &rlets you play UNO with your friends."
        "You can select &6Mino &rin the &6Maid Work Mode&r."
        "This way, you can have the maid play with you!"
        "Supports up to &64 players&r. You can summon a bot using the command:"
        "&b&n/summon minopp:mino_auto_player"
        "In &dCreative Mode&r, use &6shift+right-click &rto edit the bot."
        "Admins can set a victory reward for the Mino++ Game Table."
        "Hold the reward, stand on the Mino Game Table, and enter the command:"
        "&b&n/minopp set_table_award"
    ]
