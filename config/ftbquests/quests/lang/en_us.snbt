	quest.034ACABF80D25D29.quest_desc: [
		"&aObjective: Defeat the Bee Queen and obtain the Beehive Backpack"
		""
		"&2The Undergarden&6’s only living land is the &agreen forest&6."
		"&6The remaining natives fled here to survive."
		"&6Deep within lies a gigantic hive,"
		"&6perhaps holding all the answers."
		"&6Find the &eAbhorrent Bee&6 and meet the Bee Queen."
		""
		"&9Structure Compass: &b【The Undergarden】Bee Queen&r"
	]
	quest.034ACABF80D25D29.quest_subtitle: "Defeat the Bee Queen"
	quest.034ACABF80D25D29.title: "Bee Queen"
	quest.038BE99D4FE3442D.quest_desc: [
		"&e『&6BeLoong&e』&6 is an &aadventure and casual modpack&6 centered on &dDragon Survival&6."
		"&6Here, you can become various &ddragons&6 and survive,"
		"&6or choose to be human and learn &5Iron Magic&6."
		"&6Explore beautiful &abiomes&6 and countless &cdungeons&6;"
		"&6Enjoy cooking with &eFarmer's Delight addons&6&r&6;"
		"&6Build stunning houses with &dYuushya Townscape&r&6;"
		"&6And enjoy multiplayer fun with friends."
		""
		"&7&oSing the hymn of ice and fire, listen to forgotten melodies, study steel magic;"
		"&7&oExplore Cataclysm’s Nether, Twilight’s forests, Eternal Starlight;"
		"&7&oReturn to farmland with maids at journey’s end."
		""
		"{@pagebreak}"
		"&6Before playing, learn how to use the &e[Quest Book]."
		"&e[Quest Book]&6 helps you understand gameplay."
		"&6Open it in the &etop-left of your inventory&6."
		"&eObjectives&6 are your tasks; claim rewards manually."
	]
	quest.038BE99D4FE3442D.quest_subtitle: "Must Read"
	quest.038BE99D4FE3442D.title: "&a&lGameplay Guide"
