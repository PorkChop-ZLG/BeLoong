	quest.7D4CBD8911785C5D.quest_desc: [
		"右键单击&a唤魔师魔宠&r以绑定他，装备在项链槽中以能够召唤/取消召唤带有其键绑定的绑定魔宠，可在&6远古城市&r中找到"
		""
		"&9结构罗盘：&b远古城市"
	]
	quest.7D81132CD0C6EF1C.quest_desc: [
		"&a目标：提交苔原龙的毕业证"
		""
		"&f&l「苔原龙」"
		"六大主龙之一，掌握冰霜的力量。"
	]
	quest.7D81132CD0C6EF1C.title: "&f主龙：苔原龙"
	quest.7DA6938BDD9417AE.quest_desc: [
		"&a目标：获得龙之骨"
		""
		"&6在世界各地，都能找到巨大的&e飞龙骨架&6。"
		"&6右键拆解&e飞龙骨架&6，获得&e龙之骨&6等战利品。"
	]
	quest.7DA6938BDD9417AE.quest_subtitle: "篇章：龙族往事"
	quest.7DB7B55E956A4A94.quest_desc: [
		"&a目标：合成恐惧之灯"
		""
		"&e恐惧&6可以禁止大部分动物的生成，"
		"&6范围是半径为&264&6的球形。"
	]
	quest.7DB7B55E956A4A94.quest_subtitle: "禁止动物生成"
	quest.7DD416AF2172DFC1.title: "飞行赋能"
	quest.7DE4E3D96764D416.quest_desc: ["右键单击&a吟游诗人魔宠&r以绑定他，装备在项链槽中以能够召唤/取消召唤具有键绑定魔宠，从&4神秘宝珠&r中获得"]
	quest.7E43C24DAFAF97FB.quest_desc: [
		"《汇流来世》是一个结合《我的世界》与《泰拉瑞亚》的扩展模组，旨在打破这两款游戏原本的世界界限，为玩家带来独特的游戏体验。"
		""
		"正如其名，《汇流来世》主张将不同世界观的要素化为潺潺的流水，柔细精工地将之交织在一起。"
		""
		"MC百科：https://www.mcmod.cn/class/18650.html"
	]
	quest.7E43C24DAFAF97FB.quest_subtitle: "在MC玩泰拉瑞亚"
	quest.7E43C24DAFAF97FB.title: "汇流来世"
	quest.7E7C768023F22D2E.quest_subtitle: "提交4种鱼和2种墨囊"
	quest.7E7C768023F22D2E.title: "生鱼馄饨"
	quest.7E8A3F928299D963.quest_desc: [
		"&l&d「雪怪首领」"
		"&6生命：&a1000"
		"&6攻击：&c10"
		"&6护甲：&70"
		""
		"&l&d生成"
		"&9结构罗盘：&b雪怪洞窟&r"
	]
	quest.7E8A3F928299D963.quest_subtitle: "★★"
	quest.7E8A3F928299D963.title: "暮色森林：雪怪首领"
	quest.7EB346A1790BD94B.quest_desc: [
		"&a目标：找到公会城堡"
		""
		"&e公会城堡&6是人类抵御巨龙修建的根据地。"
		"&6找到&e公会首领&6，和他购买&e公会之钥&f。"
		""
		"&9结构罗盘：&b【龙之生存】公会城堡&r"
		""
		"{image:kubejs:textures/task/hunters_castle.png width:100 height:125 align:center}"
	]
	quest.7EB346A1790BD94B.quest_subtitle: "找到公会城堡"
	quest.7EB346A1790BD94B.title: "公会城堡"
	quest.7F3860516EB20F18.quest_desc: [
		"&d&l「严厉」"
		"{ \"text\": \"点击跳转到BOSS介绍\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0FC068CD405DBBD4\" } }"
		""
		"&6为了消灭末地的龙族，人类铸造了威力恐怖的天平："
		"&6它的本体坚不可摧，它的火力无与伦比；"
		"&6它痛恨飞行的龙族，它抹杀空中的敌人；"
		"&6它会认为万物有罪，它用激光主持公道；"
		"&6它是永恒的审判官，它是龙族的刽子手。"
	]
	quest.7F3860516EB20F18.quest_subtitle: "击败「严厉」"
	quest.7F3860516EB20F18.title: "谁能主持公道？"
