	quest.4385F7925457C289.title: "魔法书T1"
	quest.439CE3D219AEA946.quest_desc: [
		"&a目标：深入深暗之园的地下，进入邃渊"
		""
		"&5邃渊&6之中积累了&2深暗之园&6的所有肮脏之物，"
		"&6当泰拉瑞亚的腐化之地入侵，这里便成了腐烂的天堂。"
		"&6在&5邃渊&6中会不断积累&e御腐感染&6，积累满会开始扣血。"
		"&e御腐感染&6是饥饿值上方的状态栏，"
		"&6食用&e澄腐粒&6和&e澄腐团质&6可以清除腐烂。"
	]
	quest.439CE3D219AEA946.quest_subtitle: "掌管腐烂天道的司命"
	quest.439CE3D219AEA946.title: "腐烂值"
	quest.44B5EE463B467926.title: "脚饰T0"
	quest.44B85B8C33C3E538.quest_desc: [
		"&a目标：找到雪怪巢穴"
		""
		"&6有传闻说，&e星光永冻森林&6里居住着传说中的&e雪怪&6。"
		""
		"&9结构罗盘：&b【领主的崛起】雪怪巢穴&r"
	]
	quest.44B85B8C33C3E538.title: "雪怪巢穴"
	quest.44CE0CDA182CFC61.quest_desc: [
		"&a目标：挖掘渊畏澄腐矿石，获得澄腐团质"
		""
		"&e澄腐团质&6食用后可以完全清除&e御腐感染&6，"
		"&e澄腐粒&6食用后可以降低&e御腐感染&6。"
		"&e渊畏澄腐矿石&6生成于深暗之园Y小于0的地方。"
		"&6此外，&e澄腐团质&6还可用于&e凝注&6。"
	]
