	quest.02B96CE03E4B8FF7.title: "观察：幽匿尖啸体"
	quest.02EE21851AD77A5F.quest_desc: [
		"&6在神秘的星光维度，古老法师为抵御黑暗侵袭，以蕴含强大能量的星核为核心、坚硬无比的星铁为身躯，创造出星光傀儡。它能操控星光之力，射出的星光刃可造成巨额伤害，还拥有防 TP、锁血等强大防御能力 。但黑暗力量扭曲了它，如今它失控暴走，成为维度中恐怖的霸主 。"
		"{ \"text\": \"点击跳转到BOSS攻略\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6E02B2425A8EAB67\" } }"
	]
	quest.02EE21851AD77A5F.quest_subtitle: "古文明的造物"
	quest.02EE21851AD77A5F.title: "星光傀儡"
	quest.03090E47EC9BB762.quest_desc: [
		"&6炼金锅&r用于提升墨水的品质、炼制药剂等。"
