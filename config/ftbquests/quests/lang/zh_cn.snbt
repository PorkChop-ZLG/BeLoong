	quest.17A9978D7AFEA210.quest_desc: [
		"&l&d「月藤巨物」"
		"&6生命：&a3000"
		"&6攻击：&c???"
		"&6护甲：&712"
		""
		"&l&d生成"
		"&6月藤巨物在&9诅咒花园&6中心处的终点处生成。"
		"&6未被火焰点燃时，月藤巨物拥有巨额减伤，"
		"&6受到的攻击伤害均会强制降低至1点。"
		"&6月藤巨物的所有攻击伤害来源于技能。"
		""
		"&9结构罗盘：&b【永恒星光】诅咒花园&r"
		"{@pagebreak}"
		"&l&d攻略"
		"&c多带几桶岩浆倒在月藤巨物脚下即可。"
		"推荐使用&c洞穴龙&r进行战斗，持续使用炽焰之息。"
		"推荐使用热泉石剑、热泉石镰、龙炎钢剑，"
		"推荐使用火焰附加、火矢附魔。"
	]
	quest.17A9978D7AFEA210.quest_subtitle: "★★★★"
	quest.17A9978D7AFEA210.title: "永恒星光：月藤巨物"
	quest.17BEAE92E1A0B323.quest_desc: [
		"&a目标：击败史莱姆王，提交皇家凝胶"
		""
		"&2深暗之园&6中，经常能看见布满藤蔓的&a残破神庙&6，"
		"&6过去，那是&b渊居民&6祭祀的场所，但是如今已经废弃。"
		"&6中央的祭坛上，囚禁着来自异世界的&d史莱姆王&6，"
		"&6如今，&e史莱姆王&6的力量已经恢复了一部分；"
		"&6任何龙靠近，都会&c唤醒&6这团巨大的史莱姆！"
		"{ \"text\": \"点击跳转到BOSS攻略\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6E27A53C36C34AB1\" } }"
