	quest.18189EEE0D9A4F88.quest_desc: [
		"&a目标：锻造出光明使者胸甲、迅捷之靴、地狱战镰"
		""
		"恭喜你，魔法师之旅已经接近尾声。"
		""
		"这一路上，你从懵懂无知的法师学徒，"
		""
		"一步步成长为守护人族的大魔法师。"
		""
		"一路披荆斩棘，最终战胜受火者，成为新的法师之王。"
		""
		"但是你的冒险还远未结束，更多法术等你去发掘。"
		""
		"现在，穿上这身光明使者的赠礼，迎接新的挑战吧！"
	]
