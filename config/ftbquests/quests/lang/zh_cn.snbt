	quest.0CBB05169A5210EB.quest_desc: [
		"&a目标：击杀一只腐衰微体"
		""
		"&6深暗之园的原住民，曾举行了一场盛大的仪式；"
		"&6但是仪式出现了差错，召来了不可名状的&e克苏鲁&6。"
		"&6仪式中的所有人都被感染，身体腐烂变成&e腐衰生物&6。"
		"&6他们失去了灵魂，成为克苏鲁入侵此界的爪牙。"
	]
	quest.0CBB05169A5210EB.title: "腐衰微体"
