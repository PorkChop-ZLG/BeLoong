	quest.067FBF1E5A9167E0.quest_desc: [
		"&d[Essentials命令]"
		"&6/spawn &r- &a传送回出生点"
		"&6/back &r- &a返回上一次死亡或传送的地方"
		"&6/rtp &r- &a随机传送（1w格内）"
		"&6/home &r- &a回家"
		"&6/sethome &r- &a设置家的传送点"
		"&6/delhome &r- &a删除家的传送点"
		"&6/tpa 玩家名 &r- &a请求传送到玩家身边"
		"&6/nickname 昵称&r - &a设置昵称（支持特殊字符）"
		"&6/carryon clear&r - &a清除手上抱着的东西"
		""
		"&7&o注：无需开启作弊即可使用"
		"{@pagebreak}"
		"&d[FTB团队命令]"
		"&6/ftbteams party invite 玩家名 &r- &a邀请玩家加入你的团队"
		"&6/ftbteams party kick 玩家名 &r- &a将玩家踢出你的团队"
		"&6/ftbteams party leave &r- &a退出当前的团队"
		"&6/ftbteams party allies add 玩家名&r- &a给团队添加盟友"
		"&7（注：盟友拥有FTB区块的权限，不共享FTB任务）"
		"&6/ftbteams party transfer_ownership 玩家名 &r- &a将队长转让给团队的其他玩家"
		""
		"&7&o注：离线服务器必须使用命令"
	]
	quest.067FBF1E5A9167E0.quest_subtitle: "必读"
	quest.067FBF1E5A9167E0.title: "&e常用命令"
	quest.068FAE02D6CD3A80.title: "击杀：水母莉亚"
	quest.06BED8FFC050C39A.quest_desc: [
		"我在黑暗森林中发现了废墟。这是一种要塞的废墟，而这种要塞的主人通常来说是骑士。然而，这个要塞废墟是个例外：迎接我的是成群的哥布林。它们身着骑士盔甲，但是它们的行为暗示了它们并非骑士。"
		"废墟深处有个基座。看样子是骑士们用来放奖杯的基座——这是力量的象征。若能拿到某种强力法杖，我便可以削弱这保护森林的魔咒，而将某座奖杯放在这基座上便可打开通往要塞的门。"
	]
	quest.06BED8FFC050C39A.title: "强者的象征"
	quest.072FD241CD272F4C.title: "打卡：炼狱之地"
	quest.07328C6505484271.quest_desc: [
		"&d末影龙&6，正是&5星界龙&6一脉的始祖，"
		"&6昔日龙族的至高统治者。"
	]
	quest.07328C6505484271.quest_subtitle: "复活吧，我的爱龙！"
