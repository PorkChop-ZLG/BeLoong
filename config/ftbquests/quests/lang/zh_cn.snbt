	quest.45FBCC91C2442B02.quest_desc: ["{ \"text\": \"点击跳转到BOSS介绍\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6E02B2425A8EAB67\" } }"]
	quest.45FBCC91C2442B02.quest_subtitle: "击杀星光傀儡，提交其掉落物"
	quest.45FBCC91C2442B02.title: "加冕风之王座"
	quest.4631FD4DF4CFBC9F.quest_desc: [
		"&6苦力怕的变种，未受到攻击时不会进行攻击和移动行为；"
		""
		"&1受到攻击后：&6开始滚动身体并追逐目标移动，同时开始引爆自己（闪烁白光）；"
		""
		"&a相较原版苦力怕而言："
		""
		"&6苦彗怕的引爆分为两个阶段；"
		""
		"&d追逐阶段：&6与原版苦力怕一致，但完全引爆所需的时间更长，且目标需要与之拉开更远的距离才能让其取消引爆；"
		""
		"&5飞升阶段：&6在追逐阶段后，苦彗怕将会原地螺旋升天数格，并在数秒后彻底自爆；"
		""
		"&6追逐阶段可对接触的目标进行近战攻击（可被盾牌格挡）；"
		""
		"&6飞升阶段的苦彗怕将无法取消自身的引爆，且由于地面过远，对玩家和地形的破坏程度也会一定地降低；"
		""
		"&6自爆可破坏地形和物品，可被盾牌格挡。"
	]
	quest.4631FD4DF4CFBC9F.title: "天慧苦力怕"
	quest.4633599C0B5F87C4.quest_desc: [
		"&a目标：成长到始祖龙阶段，击败黑暗二重身"
		""
		"&6最终的试炼，是直面你内心的&5黑暗&6，从而超越自我！"
		"{ \"text\": \"点击跳转到BOSS介绍\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"11FC2E4D6E6B0D93\" } }"
	]
	quest.4633599C0B5F87C4.quest_subtitle: "【以太龙成长之路    完结】"
	quest.4633599C0B5F87C4.title: "&3以太龙毕业"
	quest.465680AFE754AEAD.quest_desc: [
		"&a目标：观察试炼刷怪笼1秒"
		""
		"&e试炼刷怪笼&6是我的世界原版1.21.1新加入的方块。"
		"&6在深暗之园中，试炼刷怪笼用于&e生成泰拉BOSS&6。"
		""
		"&6每个&e泰拉BOSS&6都有一个&b对应结构&6，"
		"&6结构中央有一个对应的&e试炼刷怪笼&6。"
		"&6玩家靠近时会激活试炼刷怪笼，从而开启BOSS挑战。"
		"&a正常情况下&6，挑战的泰拉BOSS是&c残血状态&6；"
		"&6喝下不祥之瓶&6，开启&4不祥试炼&6，泰拉BOSS会&c恢复满血&6！"
		"&6击败泰拉BOSS后，会掉落&2两份战利品&6，"
		"&6分别是BOSS本身掉落一份，试炼刷怪笼奖励一份。"
		"&6若是挑战&4不祥试炼&6，奖励会更加丰厚！"
	]
	quest.465680AFE754AEAD.quest_subtitle: "泰拉BOSS的召唤方式"
