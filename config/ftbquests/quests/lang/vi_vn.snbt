	quest.6D88CFA0D4618ECB.title: "Sinh Vật Mowzie: Điêu Khắc Giả - Đại Sư Thông Tý"
	quest.6E02B2425A8EAB67.quest_desc: [
		"&l&d「Tinh Quang Điêu Tượng」"
		"&6Sinh lực：&a2500"
		"&6Công kích：&c???"
		"&6Giáp：&70"
		""
		"&l&dSinh ra"
		"&6Tinh Quang Điêu Tượng sinh ra ở điểm kết thúc của&9Nhà Máy Rèn Khảo Tượng&6."
		"&6Tinh Quang Điêu Tượng không có khả năng di chuyển, miễn nhiễm sát thương lửa và đóng băng."
		"&6Các đòn tấn công của Tinh Quang Điêu Tượng đều là sát thương nhiều đoạn liên tục，"
		"&6nên tổng sát thương trong thường hợp khá không ổn định."
		""
		"&9La Bàn Cấu Trúc：&b【Tinh Quang Vĩnh Cửu】Nhà Máy Rèn Khảo Tượng&r"
		"{@pagebreak}"
		"&l&dHướng dẫn"
		"Tinh Quang Điêu Tượng ban đầu ở trạng thái nạp điện, bất khả chiếm bại."
		"&cNgười chơi phải chuột phải vào khối năng lượng để tắt nó, hoặc bắn vật thể vào cũng được."
		"Sau khi tắt hết, Tinh Quang Điêu Tượng rơi vào trạng thái vỡ phòng thủ, người chơi có thể tự do dùng các cách thông thường để tấn công và gây sát thương."
	]
	quest.6E02B2425A8EAB67.quest_subtitle: "★★★★"
	quest.6E02B2425A8EAB67.title: "Tinh Quang Vĩnh Cửu: Tinh Quang Điêu Tượng"
	quest.6E231B440990950C.quest_desc: ["&6Nhiệm vụ: đánh bại Diệt Vong Luyến Ảnh"]
	quest.6E231B440990950C.title: "Diệt Vong Luyến Ảnh"
	quest.6E3E82FB2A6E1D40.quest_subtitle: "Trưởng thành tới giai đoạn Long Trưởng Thành"
	quest.6E3E82FB2A6E1D40.title: "Thái Hà Long Trưởng Thành"
	quest.6E5594142D1F7454.quest_subtitle: "Soda thanh kiềm"
	quest.6E7C29B7BD87C467.quest_desc: [
		"&6Nhiệm vụ ẩn: nhận được Ngọc Ám Ảnh"
		""
		"&7Ngàn năm trước, một Đại Pháp Sư Tối Thượng của loài người, là vị Hắc Pháp Vương tu luyện ma thuật hắc, đã lẻn vào Long Cung và trộm đi một viên Long Châu Tổ Tiên. Từ đó trăm năm, cao thủ Long Cung lần lượt xuất đi tìm dấu vết viên long châu ấy, không bao giờ tìm thấy. Cho tới một ngày, có người long tộc cảm nhận được hơi thở của long châu sâu trong Địa Đế, nhưng long châu đã bị hắc ám ô nhiễm, biến thành&dNgọc Ám Ảnh&r."
		""
		"&dNgọc Ám Ảnh&r sẽ ảnh hưởng tâm trí của long. Nếu đặt nó lên&5Bàn Tế Ám Ảnh&r，sẽ sao chép ra&ethân xác người&r trước khi hóa long, mang theo toàn bộ bóng tối nằm sâu trong lòng người hóa long."
	]
	quest.6E7C29B7BD87C467.quest_subtitle: "Nhiệm vụ ẩn"
	quest.6E7C29B7BD87C467.title: "Ngọc Ám Ảnh"
	quest.6EA867B07E184273.quest_desc: [
		"&6Từ xa xưa, tộc Nguyệt Đằng từng là người canh giữ chiều Tinh Quang Vĩnh Cửu, dùng sức Nguyệt Đằng để giữ cân bằng chiều không gian. Nhưng một cơn bão tối đen bất ngờ ập tới, nuốt chửng phần lớn Nguyệt Đằng, phần còn lại hấp thụ quá nhiều ma lực hỗn độn và biến thành Nguyệt Đằng Cự Vật đáng kinh khủng. Nó điều khiển dây leo cứng cáp để tấn công, còn có thể giải phóng Lời Nguyền Ánh Trăng, giờ đã trở thành sinh vật mạnh mẽ khiến người ta kinh hồn trong chiều không gian。"
		"{ \"text\": \"Nhảy tới hướng dẫn BOSS\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"17A9978D7AFEA210\" } }"
	]
