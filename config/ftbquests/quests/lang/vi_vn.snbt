	quest.6C896BDFB4BBB4E4.quest_desc: [
		"&6Nhiệm vụ: học cách dùng FTB Chunk"
		""
		"&aFTB Chunk&6 có thể bảo vệ lãnh thổ của ngươi khỏi việc người chơi khác phá hoại."
		"&6Kể cả khi chơi đơn, cũng có thể dùng làm&abộ nạp chunk&a."
		""
		"&6Nhấn&d【E】&6 để mở Tú Đồ, bấm&2Chiếm Chunk&2 ở góc trên trái màu xanh đậm，"
		"&6sẽ thấy bản đồ phủ lưới, mỗi ô là một&2chunk&6."
		"&d【Chuột trái】&6 bấm vào chunk trên bản đồ,&2 đổi màu&6 nghĩa là chiếm thành công."
		"&d【Chuột phải】&6 bấm vào chunk đã chiếm để giải chiếm."
		"&d【Shift chuột trái】&6 bấm vào chunk đã chiếm, xuất hiện&2đường chéo&6，"
		"&6nghĩa là đã nạp cưỡng bức. Nạp cưỡng bức chỉ có hiệu lực khi&2có người chơi trong đội đang online&6."
		"&d【Shift chuột phải】&6 bấm vào chunk đã nạp cưỡng bức để huỷ nạp."
		""
		"&6Nếu muốn cấp quyền lãnh thổ cho người chơi khác, hoặc là vào cùng một đội，"
		"&6hoặc là thêm đồng minh. Càng nhiều người chơi trong đội thì càng chiếm được nhiều chunk."
		""
		"{@pagebreak}"
		"&6Chức năng&abản đồ nhỏ&6 của FTB Chunk đã bị vô hiệu hoá và không thể khôi phục，"
		"&6nhấn&d【,】&6 để mở bản đồ thế giới của FTB Chunk&7（tương tự bản đồ Xaero）"
		"&6Có thể xem&2lãnh thổ của người chơi khác&6 và&2bia đá dịch chuyển đã kích hoạt&6."
	]
	quest.6C896BDFB4BBB4E4.quest_subtitle: "Hướng dẫn dùng FTB Chunk"
