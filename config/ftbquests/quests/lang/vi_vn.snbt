	quest.3F6C84E422ACA0D2.title: "Nhà Máy Rèn Linh Hồn"
	quest.3FB2C999F046AAE3.quest_desc: [
		"&6Nhiệm vụ: dùng hắc diện thạch dựng Cổng Dịch Giới, vào địa ngục.&r"
		""
		"Địa ngục là vùng đất kho tàng, chứa vô số vật liệu phép thuật."
		""
		"Cùng cơ hội là cả nguy hiểm, địa ngục đầy cấu trúc tai biến，"
