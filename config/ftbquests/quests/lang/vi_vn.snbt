	quest.1DFB8CC52BD51F13.quest_desc: [
		"Nữ tỳ thích bánh nhất!"
		"Dùng bánh cho nữ tỳ đã triệu hồi, nàng sẽ thuộc về ngươi."
		""
		"&aSau khi hoàn thành chương này, có thể mua&d【Thế Thân Địa Tạng】&6 trong cửa hàng hệ thống"
	]
