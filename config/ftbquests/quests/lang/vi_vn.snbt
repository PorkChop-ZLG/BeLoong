	quest.5B17EE2B443E6FAB.quest_desc: [
		"&6Nhiệm vụ: quan sát khung Cổng Dịch Thiên Tai trên đỉnh trạm không gian"
		""
		"Sau khi thu đủ&a12 loại nhãn cầu đặc biệt&r, cho chúng vào&aKhung Cổng Dịch Thiên Tai&r là có thể kích hoạt&cCổng Dịch Thiên Tai&r."
		""
		"12 loại nhãn cầu lần lượt là:"
		""
		"&dNhãn Từ Bi"
		"&dNhãn Vương Quốc"
		"&dNhãn Nghiêm Khắc"
		"&bNhãn Cơ Khí"
		"&bNhãn Liệt Hoả"
		"&bNhãn Hư Vô"
		"&bNhãn Cự Thú"
		"&bNhãn Thâm Uyên"
		"&bNhãn Sa Mạc"
		"&bNhãn Nguyền Rủa"
		"&bNhãn Phong Bạo"
		"&bNhãn Ảnh"
		""
		"&8&oChú ý: vì Boss Tai Biến mới — Onyx chưa làm xong nên tạm dùng Nhãn Ảnh thay thế."
	]
	quest.5B17EE2B443E6FAB.quest_subtitle: "Bí mật cuối cùng được canh giữ trong trạm không gian"
