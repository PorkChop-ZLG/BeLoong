	quest.317F86F342B23460.quest_desc: [
		"&6Nhiệm vụ: quan sát Lò Rèn Mạng trong nhà tân thủ"
		""
		"&6Quản Trị Viên Mạng Lưới Chiều Không, cầm tay trắng Shift chuột phải để gắn vào mạng hiện tại."
		""
		"&6Có thể lấy nguyên liệu từ mạng theo đánh dấu đầu vào, lấy nhiên liệu theo đánh dấu nhiên liệu, thành phẩm có thể cất thẳng vào mạng, cũng có thể nhờ chế độ đẩy ra có sẵn để xuất ra thùng chứa liền kề."
	]
	quest.317F86F342B23460.title: "Quan Sát: Lò Rèn Mạng"
	quest.31A9F50E9E58685D.quest_subtitle: "Nâng 4 kỹ năng bị động của Hải Long lên tối đa"
	quest.31A9F50E9E58685D.title: "Nắm Chân Nghĩa Của Thủy"
	quest.31D2F941929D88CD.title: "Hộ Phùng T1"
	quest.31E0FB1E1052AF73.quest_subtitle: "Nộp mọi món ăn riêng của Thái Hà Long"
	quest.31E0FB1E1052AF73.title: "Món Ngon Của Thái Hà Long"
	quest.31EE8CBCF76E869A.quest_subtitle: "Nhìn nó thôi đã đã khát rồi?"
