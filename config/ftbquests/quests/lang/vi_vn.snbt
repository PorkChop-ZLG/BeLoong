	quest.7D81132CD0C6EF1C.quest_desc: [
		"&6Nhiệm vụ: nộp Giấy Tốt Nghiệp của Tuyết Nguyên Long"
		""
		"&f&l「Tuyết Nguyên Long」"
		"Một trong Lục Đại Chủ Long, nắm giữ sức mạnh sương giá."
	]
	quest.7D81132CD0C6EF1C.title: "&fChủ Long: Tuyết Nguyên Long"
	quest.7DA6938BDD9417AE.quest_desc: [
		"&6Nhiệm vụ: nhận được Cốt Long"
		""
		"&6Khắp khắp thế giới đều có thể tìm thấy những bộ&exương Phi Long khổng lồ&6."
		"&6Chuột phải tháo dỡ&eXương Phi Long&6 để nhận&eCốt Long&6 và các chiến lợi phẩm khác."
	]
	quest.7DA6938BDD9417AE.quest_subtitle: "Chương: Chuyện Cũ Long Tộc"
