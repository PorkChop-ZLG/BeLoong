	quest.1E7A718688067EC6.quest_desc: [
		"&l&d「Điêu Linh」"
		"&6Sinh lực：&a600"
		"&6Công kích：&c???"
		""
		"&l&dSinh ra"
		"&6Xếp 4 Linh Hồn Cát hoặc Linh Hồn Thổ thành hình chữ T theo hướng bất kỳ, rồi đặt một Đầu Lưng Tiêu Điêu Linh lên mỗi khối Linh Hồn Cát hoặc Linh Hồn Thổ ở ba khối phía trên của hình T. Hai góc của hình T phải là không khí. Khối đặt cuối cùng phải là Đầu Lưng Tiêu Điêu Linh, có thể do người chơi hoặc bộ phát đặt. Linh Hồn Cát và Linh Hồn Thổ có thể trộn lẫn, cả Đầu Lưng Tiêu Điêu Linh và toàn bộ cấu trúc cũng có thể đặt theo hướng bất kỳ."
	]
	quest.1E7A718688067EC6.quest_subtitle: "★★"
	quest.1E7A718688067EC6.title: "Gốc: Điêu Linh"
