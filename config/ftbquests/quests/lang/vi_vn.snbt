	quest.346F1B08A0E6345D.quest_desc: [
		"&5Sách phép&r cần trang bị mới dùng được."
		"&aCách 1&r：cầm sách phép chuột phải là tự động trang bị."
		"&aCách 2&r：bấm&6ô Trang Sức&6 ở góc trên trái Tú Đồ để trang bị."
		"&aCách thi triển&r："
		"1、Nhấn&d【T】&r để mở&5Vòng Pháp&r，di chuyển chuột để chọn phép."
		"2、Nhấn【&dV】&r để thi triển phép, cần tiêu hao&5Giá Trị Pháp Lực&r."
		""
		"&cChú ý: bộ tích hợp này đã đổi phím, nếu không quen hãy tự đổi！"
	]
