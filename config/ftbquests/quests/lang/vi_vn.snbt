	quest.3478FDACA97D4803.title: "Lĩnh Đạo Luyện Nhân"
	quest.347C54BAEC42A4AA.quest_desc: [
		"&6Nhiệm vụ: đánh bại Diệt Vong Cấu Thể"
		""
		"&#6BBB0BDiệt Vong Cấu Thể&r，bản thân là một Mắt Ảnh khổng lồ dùng sức mạnh nguyên tố “Diệt Vong” tạo ra từ việc kết hợp Ngọc Trao Hư Ảnh và Liệt Hoả Phấn; khi người chơi dùng Thủy Tinh Nhãn dịch nó tới trước mặt, nó sẽ điều khiển các bộ phận xung quanh tạo thành giáp bao bọc chính mình, và phong hậu cho bất kỳ sinh vật nào dám dịch nó tới đây bằng Diệt Vong."
	]
	quest.347C54BAEC42A4AA.quest_subtitle: "Tinh Hà vỡ nát, đại đạo diệt vong!"
	quest.347C54BAEC42A4AA.title: "&l&#6BBB0BDiệt Vong Cấu Thể"
