	quest.160F11820FD39F91.quest_desc: [
		"&6Nhiệm vụ: đánh bại Giám Thủ Giả"
		""
		"&eGiám Thủ Giả&r vốn phải ở trong&eThành Cổ Đại&r. &eĐội khảo cổ Nether&r đào nó lên, cất vào địa ngục nghiên cứu, và dường như nó đang bảo vệ thứ gì đó."
		""
		"&eGiám Thủ Giả&r tuy không phải Boss nhưng lại khó nhằn hơn nhiều Boss. Nó không có thị lực nhưng thính giác vô cùng nhạy, bất cứ động tĩnh nào cũng khiến nó tấn công ngươi."
		""
		"{ \"text\": \"Bấm tôi để nhảy tới hướng dẫn Boss\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0B1F2B46DAF0D8AC\" } }"
	]
