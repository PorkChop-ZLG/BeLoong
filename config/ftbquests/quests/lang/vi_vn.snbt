	quest.1B240FEAC3D29C3B.quest_desc: [
		"&6Nhiệm vụ: nhận được trứng của bất kỳ Phi Long nào"
		""
		"&eTrứng Long&6 là con đường duy nhất để thuần Phi Long trong chế độ sinh tồn，"
		"&6ấp trứng sẽ được một Phi Long nhỏ đã thuần."
		""
		"&6Trứng Long có thể tìm thấy trong rương ở&eHang Mẫu Long&6，"
		"&6cũng có thể do&ePhi Long cái cấp 4 trở lên&6 rơi ra 0~3 quả."
		"&6Mọi Phi Long đều có khả năng sinh sản, cho chúng ăn thức ăn sinh sản tương ứng，"
		"&6hai con Phi Long khác giới tính cùng thuộc tính sẽ bắt đầu sinh sản，"
		"&6sau khi sinh sản xong vào thời gian chờ 300 giây, trứng cần 6 phút để ấp."
		""
		"&cTrứng Hoả Long: ấp trong lửa"
		"&bTrứng Băng Long: ấp trong nước"
		"&dTrứng Điện Long: ấp khi phơi mưa/sấm sét ở Thế Giới Chính"
	]
	quest.1B240FEAC3D29C3B.quest_subtitle: "Hướng dẫn ấp trứng"
