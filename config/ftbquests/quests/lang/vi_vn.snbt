	quest.3DF3F67A1FEA8AFE.title: "Nhận Điểm P"
	quest.3E52E801E902AB50.quest_desc: [
		"&6Khi cập nhật phiên bản, kỹ năng long tộc của bản lưu cũ sẽ không được cập nhật."
		"&6Dùng lệnh này có thể đặt lại kỹ năng của long tộc."
		"&cChú ý: kỹ năng đã nâng cấp cũng sẽ bị đặt lại!"
	]
	quest.3E52E801E902AB50.quest_subtitle: "Dùng để cập nhật kỹ năng long tộc"
	quest.3E52E801E902AB50.title: "&cĐặt Lại Kỹ Năng Long Tộc"
	quest.3E5F53B92682C2E2.quest_desc: [
		"&6Trong Chiều Tinh Quang có một khu vườn nguyền rủa bí ẩn. Bước vào đó, nguy hiểm lập tức bao trùm. Nơi đây đầy thực vật mang lời nguyền biến mất, chạm vào là vật phẩm lập tức biến mất; lại còn gai mang lời nguyền ràng buộc, mắc vào thì khó thoát ra trừ khi chết hoặc hỏng, kẻ dũng cảm mới dám khám phá bí ẩn bên trong。"
		""
		"&9La Bàn Cấu Trúc：&b【Tinh Quang Vĩnh Cửu】Vườn Nguyền Rủa"
	]
	quest.3E5F53B92682C2E2.quest_subtitle: "Chuẩn bị và mặc ít nhất một bộ Thạch Nhiệt Tuyền, chỉ lửa liệt mới phá được loài thực vật khổng lồ bám ở đây"
