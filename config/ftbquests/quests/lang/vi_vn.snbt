	quest.4F9B70EE7BB0E995.quest_desc: [
		"&6Nhiệm vụ: nhận được Huyết Điện Long"
		""
		"&dVảy Điện Long + Bình Thuỷ Tinh = Huyết Điện Long（Lò rèn Long Lăng）"
		"&dThỏi Chiêm Dạ Chi + Huyết Điện Long = Thỏi Thiên Tặng（Lò rèn Long Lăng）"
	]
	quest.4F9B70EE7BB0E995.quest_subtitle: "Có thể luyện thép Long"
	quest.4FCCF9100795CFEB.title: "Thần Trong Thần"
	quest.5003D0EDCDBEB34E.quest_desc: [
		" Hắn chắc chắn từng là một phù thủy thực lực không thể xem thường, nổ hỏa, dịch chuyển, triệu hồi, với hắn cũng chỉ là thủ đoạn nhỏ để đuổi khách không mời. Thực lực như vậy đáng để ta công nhận."
		" Nhưng khi vuốt long của ta đâm vào ngực hắn đã không còn nhịp đập, đầm lầy nóng bỏng, rừng đen kịt, vùng đất tuyết phủ, những ràng buộc hắn từng gây ra cuối cùng cũng được mở."
	]
	quest.5003D0EDCDBEB34E.quest_subtitle: "&7Ta ghét mùi thối rữa này"
	quest.5003D0EDCDBEB34E.title: "&bBất Tử Hạ Nhân Thấp Kém"
	quest.5026FCE365E612AF.quest_subtitle: "Áo đỏ huyết nhượng vang nước rượu"
	quest.5026FCE365E612AF.title: "&4Học Phái Huyết Sắc"
	quest.50845BE41812C191.quest_desc: [
		"&eYên Súc Pháp Thuật&6mô-đun&c phải cấu hình&6 mới dùng được，"
		"&6giữ&d【T】&6 để đọc&e câu thần chú đã đặt&r，lập tức thi triển phép！"
		""
		"&6Cách cấu hình:"
		"&a1、Nhấn&d【;】&a trong game để mở cấu hình&7（phím bên phải L）"
		"&a2、Bấm nút&e【Ghi Âm Mẫu】&a；"
		"&a3、Chọn một phép thuật, bấm nút&e【Bấm Ghi Âm】&a ở góc dưới trái；"
		"&a4、Nội dung ghi âm tuỳ ý, rồi bấm nút&e【Dừng Ghi Âm】&a；"
		"&a5、Nên ghi mỗi phép thuật&c5 tới 10 lần&a để tăng độ chính xác；"
		"&a6、Sau khi ghi xong bấm nút&e【Kiểm Tra Khớp】&a；"
		"&a7、Sau khi ghi thành công, trang bị phép tương ứng, giữ&d【Alt】&a để ngâm thừ chú ngươi đặt, thả ra là có thể thi triển phép bằng giọng nói! Tiếng ngâm của ngươi sẽ&cthay thế tiếng ngâm phép gốc, từ đó thi triển phép tức thời！"
	]
	quest.50845BE41812C191.quest_subtitle: "Thi triển phép bằng giọng nói"
	quest.50845BE41812C191.title: "Sắt Ma Thuật: Yên Súc Pháp Thuật"
	quest.508986FA5D56C11E.quest_desc: [
		"&6Nhiệm vụ: trưởng thành tới giai đoạn Long Tổ Tiên, đánh bại Song Sinh Hắc Ám"
		""
