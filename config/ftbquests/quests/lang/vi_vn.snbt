	quest.71F5D112B526DB55.quest_desc: [
		"&6Nhiệm vụ: sau khi hiểu đặc tính của long, bấm ✅ ở góc trên trái"
		""
		"&6■Động Long&7 là chân Long sống trong hang động và dung nham, có thể phun lửa để nung chảy khoáng.\\n\\n&2■Đặc tính:&7Ma thuật nguyên tố hỏa, miễn nhiễm lửa, vuốt như cuốc có thể đào đá.\\n&4■Lời nguyền:&7E sợ nước và sợ rét, ở trong nước và vùng lạnh sẽ mất sinh lực.\\n\\n&3■Điều kiện mở khóa:&7\\n1.Hoàn thành&6Hướng dẫn tân thủ&7。&r"
	]
