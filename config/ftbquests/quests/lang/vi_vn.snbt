	quest.37794577F6B10689.quest_desc: ["{ \"text\": \"Nhảy tới giới thiệu BOSS\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6583633BEC31ECDF\" } }"]
