	quest.50A8397A7FF4CF05.quest_desc: [
		"&6Nhiệm vụ: tìm Đấu Trường Thiết Chi"
		""
		"&cThiết Chi Thủ&r vốn ở địa ngục yên ổn, nhưng không hiểu sao bị người ta chuyển cả nhà tới Địa Đế..."
