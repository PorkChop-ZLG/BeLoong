	quest.7D0C169A64527891.quest_desc: [
		"&6Nhiệm vụ: đánh bại bộ xương linh hồn và Tiêu Điêu Linh Kỵ Sĩ"
		""
		"Cổng cổ thành bị khoá chặt, có lẽ những bộ xương bên ngoài sẽ có chìa khóa."
	]
	quest.7D0C169A64527891.quest_subtitle: "Thật sự có rơi chìa khóa không?"
	quest.7D0C169A64527891.title: "Chiến Sĩ Bộ Xương"
