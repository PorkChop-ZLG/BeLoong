	quest.5BB4A81605A76537.quest_desc: [
		"&6Nhiệm vụ: hoàn thành mọi con đường trưởng thành của Chủ Long."
		"&6Nhiệm vụ: trải nghiệm mọi loài Tòng Long."
		""
		"&6Dù đường có dài, cũng có điểm dừng; hành trình Hóa Long tới đây khép lại."
		"&6Những gian khổ trên đường, ngươn gút thành ký ức quý giá."
		""
		"&7Có sự tò mò lần đầu hóa thành long; có niềm vui trở lại Rừng Hoàng Hôn;"
		"&7có duyên gặp Tinh Quang Vĩnh Cửu; có nỗi sợ thoát khỏi Vườn Tối Sâu Thẳm."
		""
		"&cLửa Động, thiêu cháy cồng chiều; &2Sương Rừng, hồi sinh đại địa;"
		"&9Lôi Hải, sóng lớn như sét; &fTuyết Tuyết Nguyên, đóng băng ngàn dặm;"
		"&3Gió Thái Hà, quét sạch bốn phương; &eÝ Thanh Long, chính khí ngàn thu."
		""
		"&d“Kim lân khởi hồi trường, nhất ngộ phong vân biết hóa long.”"
		"&d“Cửu thiên long long kinh thiên biến, phong vân lợi hội thiển thủy du.”"
		""
		"&l&eCuối cùng, chúc mọi người chơi『Hóa Long』:"
		"&l&eTiền đồ xuôi thuận, mã đến thành công, vân chinh phát bĩnh, nguy hóa long thành!"
		""
		"{ \"text\": \"Bấm để xem danh sách cảm tạ\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"359B897165997027\" } }"
	]
