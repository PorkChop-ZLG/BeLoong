	quest.7A29CD2932DB3DC7.quest_desc: [
		"&6Nhiệm vụ: quan sát Xương Đồng Nguyệt Chúc"
		""
		"Xương Đồng Nguyệt Chúc sinh ra tự nhiên thường có một “quả” ở đỉnh khác văn bản dưới đáy；"
		""
		"phá quả sẽ rơi ra 1 miếng cánh Nguyệt Quả；"
		""
		"dùng kéo chuột phải một lần lên quả sẽ biến nó thành&aĐương Quy Tiêu Ngạch Cừu Kinh&r，sau đó phá sẽ rơi chính khối đó；"
		""
		"phá Xương Đồng Nguyệt Chúc nối liền và nằm thấp hơn thì những cây phía trên nối liền cũng bị phá theo；"
		""
		"nếu quả đã thành Đương Quy Tiêu Ngạch Cừu Kinh thì bản thân nó không bị phá khi cây phía dưới nối liền bị phá."
	]
