	quest.6CC5B640AD43F55C.quest_desc: [
		"&6Nhiệm vụ: nhận được bàn chế tạo và đe"
		""
		"&eBàn chế tạo&6 bị thay bằng&ebàn chế tạo trực quan&6，có thể lưu vật liệu chế tạo và xem trước vật phẩm kết quả."
		""
		"&eĐe&6&6 bị thay bằng&eđe đơn giản&6，đã gỡ bỏ hạn chế quá đắt và hỗ trợ mã định dạng."
		""
		"&eBảng tên&6 có thể dùng chuột phải trực tiếp, và đã có công thức chế tạo."
		""
		"&7&oChú ý: nếu dùng mod chiếu hình, bàn chế tạo và đe sẽ không nhận diện được"
	]
	quest.6CC5B640AD43F55C.quest_subtitle: "Nhiều chức năng hơn"
	quest.6CC5B640AD43F55C.title: "Bàn Chế Tạo Và Đe Tốt Hơn"
	quest.6D04FF23B1FBF2B8.quest_desc: ["&6Nhiệm vụ: sau khi bị Tiềm Ảnh tấn công thì trôi lên cao 50 ô"]
	quest.6D04FF23B1FBF2B8.title: "Vỏ Tiềm Ảnh"
	quest.6D4C0BF934994972.quest_desc: [
		"&6Nhiệm vụ: dùng Máy Phát Mạng Lưới Chiều Không để tạo một mạng chiều không gian"
		""
		"Khi hướng dẫn tân thủ kết thúc, ta đã tặng ngươi một&bmáy phát mạng lưới chiều không gian&r."
		""
		"Thứ này đỉnh thật đấy, cầm trên vuốt&d【chuột phải】&r dùng, rồi nhấn&dphím【O】&r là có được một kho&adung tích vô hạn&r，gọi là&bmạng chiều không gian&r."
		""
		"Mọi vật phẩm ngươi có thể cho vào mạng chiều không gian,&a&nkhông lo đầy, không lo mất&r. Lấy dùng thoải mái, rất tiện."
		""
		"Cách dùng cụ thể, bấm vào liên kết bên dưới:"
		"{ \"text\": \"Giới thiệu chi tiết Siêu Việt Chiều Không\", \"underlined\": true, \"color\": blue, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4A5D5042C28278A2\" } }"
	]
