	quest.067FBF1E5A9167E0.quest_desc: [
		"&d[Lệnh Essentials]"
		"&6/spawn &r- &aDịch về điểm sinh ra"
		"&6/back &r- &aQuay lại nơi chết hoặc dịch lần trước"
		"&6/rtp &r- &aDịch ngẫu nhiên (trong 1w ô)"
		"&6/home &r- &aVề nhà"
		"&6/sethome &r- &aĐặt điểm dịch về nhà"
		"&6/delhome &r- &aXoá điểm dịch về nhà"
		"&6/tpa tên người chơi &r- &aXin dịch tới bên người chơi"
		"&6/nickname biệt danh&r - &aĐặt biệt danh (hỗ trợ ký tự đặc biệt)"
		"&6/carryon clear&r - &aBỏ vật đang ôm trên tay"
		""
		"&7&oChú ý: không cần bật gian lận cũng dùng được"
		"{@pagebreak}"
		"&d[Lệnh FTB Team]"
		"&6/ftbteams party invite tên người chơi &r- &aMời người chơi vào nhóm của ngươi"
		"&6/ftbteams party kick tên người chơi &r- &aĐuổi người chơi ra khỏi nhóm"
		"&6/ftbteams party leave &r- &aRời khỏi nhóm hiện tại"
		"&6/ftbteams party allies add tên người chơi&r- &aThêm đồng minh cho nhóm"
		"&7（Chú ý: đồng minh có quyền hạn FTB Chunk, không dùng chung FBT Nhiệm Vụ）"
		"&6/ftbteams party transfer_ownership tên người chơi &r- &aChuyển quyền đội trưởng cho người chơi khác trong nhóm"
		""
		"&7&oChú ý: server offline bắt buộc phải dùng lệnh"
	]
	quest.067FBF1E5A9167E0.quest_subtitle: "Bắt Buộc Đọc"
	quest.067FBF1E5A9167E0.title: "&eLệnh Thường Dùng"
	quest.068FAE02D6CD3A80.title: "Hạ: Thuỷ Mê Liễu"
	quest.06BED8FFC050C39A.quest_desc: [
		"Ta phát hiện phế tích trong rừng tối. Đây là tàn tích của một pháo đài, mà chủ nhân của loại pháo đài ấy thường là kỵ sĩ. Nhưng tàn tích này là ngoại lệ: nơi đón ta là đám goblin. Chúng mặc giáp kỵ sĩ, nhưng hành vi của chúng cho thấy chúng không phải kỵ sĩ."
		"Trong sâu phế tích có một bệ đá. Trông như bệ để các kỵ sĩ đặt giải thưởng——đó là biểu tượng của sức mạnh. Nếu có được cây pháp thuật uy lực, ta có thể phá lễ nguyền bảo vệ khu rừng này, và chỉ cần đặt một giải thưởng lên bệ đá là mở được cánh cửa tới pháo đài."
	]
	quest.06BED8FFC050C39A.title: "Biểu Tượng Của Kẻ Mạnh"
	quest.072FD241CD272F4C.title: "Điểm Danh: Liêm Uyên Chi Địa"
