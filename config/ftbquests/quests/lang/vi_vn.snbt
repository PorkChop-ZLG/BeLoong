	quest.0256EDAC77E359BD.title: "Trang Bị Chiến Sĩ Ma Thuật"
	quest.0290886F399EB569.quest_desc: [
		"&6Qua điện thoại, ngươi có thể mua ngay nguyên liệu nấu ăn hoặc rượu, đương nhiên phần lớn rượu chỉ có được khi dùng điện thoại&r"
		""
		"&o&7Mọi lúc mọi nơi, không kể nắng mưa！&r&r"
	]
	quest.0290886F399EB569.quest_subtitle: "Công Cụ Xuất Hàng Nhanh"
	quest.0294A7EFD83D05F9.quest_desc: [
		"&6Nhiệm vụ: kích hoạt Cổng Dịch Giới, tới địa ngục"
		""
		"Cửa địa ngục mở ra, phía sau là một căn phòng nhỏ ngập khí tức địa ngục."
		""
		"Nhưng khung cổng dịch giới đã bị ai đó tháo dỡ. May mà trên tường sau cửa có&eHắc Diện Thạch&r và&eĐá Lửa&r, ngươi có thể sửa lại và kích hoạt cổng dịch giới."
		""
		"Đặt ba&eHắc Diện Thạch&r vào chỗ khuyết trước cửa, rồi dùng&eĐá Lửa để đốt&r trên hắc diện thạch là mở được&cCổng Dịch Giới&r."
	]
	quest.0294A7EFD83D05F9.quest_subtitle: "Hóa ra còn phải tự lắp"
	quest.0294A7EFD83D05F9.title: "Cổng Dịch Giới"
	quest.02B96CE03E4B8FF7.title: "Quan Sát: Thể Gầm Than"
	quest.02EE21851AD77A5F.quest_desc: [
		"&6Tại chiều không gian tinh quang bí ẩn, cổ pháp sư chống lại xâm nhập bóng tối đã tạo ra tinh quang điêu tượng với lõi là tinh hạt chứa năng lượng mạnh, thân là nguyên liệu tinh thiết cứng nhất. Nó điều khiển lực tinh quang, lưỡi tinh quang bắn ra gây sát thương cực lớn, lại còn có khả năng phòng TP, khóa máu mạnh mẽ. Nhưng thế lực tối đã xuyên tạc nó, giờ nó mất kiểm soát hung hăng, trở thành bá chủ khủng khiếp của chiều không gian."
		"{ \"text\": \"Nhảy tới hướng dẫn BOSS\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6E02B2425A8EAB67\" } }"
	]
	quest.02EE21851AD77A5F.quest_subtitle: "Tác phẩm của nền văn minh cổ đại"
	quest.02EE21851AD77A5F.title: "Tinh Quang Điêu Tượng"
	quest.03090E47EC9BB762.quest_desc: [
		"&6Luyện Kim Nồ&r dùng để nâng chất lượng mực, luyện thuốc dược."
		""
		"Có thể dùng EMI để tra cụ thể luyện kim nồ dùng để làm gì."
		""
		"Cách dùng luyện kim nồ khá phức tạp, ở đây không giới thiệu."
		""
		"Tìm “Luyện Kim Nồ” trên MC Baike để xem chi tiết."
	]
	quest.03090E47EC9BB762.quest_subtitle: "Trở thành luyện kim sư đi"
	quest.032B061110A311CA.title: "Trang Bị Pháp Vương Lôi Điện"
	quest.03300B3D470F9B73.quest_desc: [
		"&6Đầu đĩa thanh&r dùng để phát nhạc đĩa Nhạc Cloud Netease."
		""
		"Chỉnh âm lượng：&n&aTùy chọn - Âm thanh và Nhạc - Đầu đĩa thanh"
		""
