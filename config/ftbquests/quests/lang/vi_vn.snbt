	quest.7DFFA6C409B39CC1.quest_subtitle: "Địa Đế là vĩnh đêm mà"
	quest.7DFFA6C409B39CC1.title: "&l&bPhù Yêu Dêm Khu"
	quest.7E43C24DAFAF97FB.quest_desc: [
		"《Hợp Lưu Lai Thế》 là một mod mở rộng kết hợp《Minecraft》với《Terraria》, nhằm phá vỡ ranh giới thế giới vốn có của hai game, mang tới người chơi trải nghiệm chơi độc đáo."
		""
		"Đúng như tên gọi,《Hợp Lưu Lai Thế》chủ trương hòa tan các yếu tố khác worldview thành dòng nước êm chảy, khéo léo đan xen chúng lại với nhau."
		""
		"MC Baike: https://www.mcmod.cn/class/18650.html"
	]
	quest.7E43C24DAFAF97FB.quest_subtitle: "Chơi Terraria trong MC"
