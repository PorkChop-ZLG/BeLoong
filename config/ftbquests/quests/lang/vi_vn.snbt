	quest.453ED60248E2C10C.quest_desc: [
		"&6Nhiệm vụ: sau khi hiểu đặc tính của long, bấm ✅ ở góc trên trái"
		""
		"&6■Lâm Long&7 là chân Long ẩn trong khu rừng rậm, giỏi ẩn thân săn mồi, cũng có thể thúc chính cây trồng.\\n\\n&2■Đặc tính:&7Ma thuật nguyên tố mộc, hút sinh lực, vuốt như rìu có thể chặt cây.\\n&4■Lời nguyền:&7E sợ bóng tối, mất dần giá trị no vì không quang hợp.\\n\\n&3■Điều kiện mở khóa:&7\\n1.Hoàn thành&6Hướng dẫn tân thủ&7。&r"
	]
	quest.453ED60248E2C10C.quest_subtitle: "Bấm để hiểu Lâm Long"
	quest.453ED60248E2C10C.title: "Lâm Long"
	quest.45865A0F5D63488F.quest_desc: [
		"&l&dNghịch Chakra「Vương Quốc」"
		""
		"&7Vị vua từng yêu dân như con, cai trị một đất nước cực thịnh，"
		"&7nhưng vì hào phóng mù quáng đã chôn vùi vương quốc của chính mình."
		""
		"&aKhuyến nghị: thử thách hắn vào ban đêm&7&o（vì bầu trời rất đẹp）"
		""
		"&9Đấu Trường Vương Quốc&6 bị Vương Quốc nắm quyền, ngươi không thể phá hay đặt khối."
		""
		"&d「Vương Quốc」&6tấn công chia thành&bthuộc tính băng&6 và&cthuộc tính lửa&6，trên đảo, tâm ngắm của ngươi sẽ có một vòng tròn hiện thuộc tính yếu điểm."
		"&d「Vương Quốc」&6bản thân không thể bị đánh trực tiếp, chỉ trong lúc&ePháo Tranh Đấu&6 mới có thể bắn&ePháo Vương Quốc&6 để gây sát thương."
		""
		"&bLa Bàn Cấu Trúc：&9【Nghịch Chakra】Đấu Trường Vương Quốc &r"
		""
		"&c&l【Hướng dẫn BOSS ở trang sau！】"
		""
		"{@pagebreak}"
		"&c&lHướng dẫn BOSS「Vương Quốc」："
		""
		"&6Chuột phải&vào&9Dựng BOSS Vương Quốc&6 ở giữa&9Đấu Trường Vương Quốc&6，đọc kỹ từng giới thiệu kỹ năng, rồi bấm&9Bắt Đầu Trận BOSS&6 ở góc trên trái."
	]
