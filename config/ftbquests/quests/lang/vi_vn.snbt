	quest.26C96833C1F6A28B.title: "Liệt Hoả Nhân"
	quest.26F59CBF01B32CE6.quest_desc: [
		"&6Nhiệm vụ: thu thập đủ mọi BOSS trong Đồ Thư Quái Vật"
		""
		"&6Thời ấu nhi, bị nhân tộc truy đuổi đến tận cùng；"
		"&6Thời thanh niên, lên đường tìm dấu vết địch；"
		"&6Thành niên, không sợ địch mạnh phô trương uy nghi；"
		"&6Đã thành Cổ Đại, lại gặp địch mới nghiêm trọng；"
		"&6Xuyên phá Thái Cổ, nắm bản nguyên vạn pháp thông；"
		"&6Cuối cùng thành Tổ Tiên, bất chiến thiên hạ cường long."
		""
		"{ \"text\": \"Bấm để xem danh sách cảm tạ\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"359B897165997027\" } }"
	]
	quest.26F59CBF01B32CE6.quest_subtitle: "Thu đủ Đồ Thư Lĩnh Chủ là thông game"
	quest.26F59CBF01B32CE6.title: "&e【Thu Thập Toàn Bộ Lĩnh Chủ】"
	quest.282FECD2B1F669AD.quest_subtitle: "Điều ngươi muốn biết đều ở đây"
	quest.282FECD2B1F669AD.title: "Cẩm Nghệ Chỉ Nam"
	quest.28625E49F473135B.quest_desc: [
		"&l&d「Thủ Đạt Nhân」"
		"&6Sinh lực：&a2000"
		"&6Công kích：&c65"
		"&6Giáp：&715"
		""
		"&l&dSinh ra"
		"&6Trong bộ tích hợp này, là BOSS cuối cùng của&bLâu Đài Chung Tàn&6 của Rừng Hoàng Hôn."
		"&6Chuột phải Thủ Đạt Nhân để nói chuyện, chọn thử thách là bắt đầu giao tranh."
		"&6Dĩ nhiên còn có các lựa chọn khác cung cấp chức năng tương ứng cho người chơi."
		""
		"&9La Bàn Cấu Trúc：&bLâu Đài Cao Nguyên Chung Tàn&r"
		"{@pagebreak}"
		"&l&dHướng dẫn"
		"Cùng một Thủ Đạt Nhân có thể thử thách lại nhiều lần, mỗi lần thử thách thành công,"
		"sát thương mọi chiêu thức của Thủ Đạt Nhân đó sẽ&avĩnh viễn +5%&r."
		"Cộng thêm sát thương có giới hạn, tối đa tăng gấp 3."
		"Nể tay: nếu đòn tiếp theo của Thủ Đạt Nhân đủ để giết người chơi, Thủ Đạt Nhân sẽ lập tức ngừng chiến."
		"Khi ngừng chiến, cái chết của người chơi đó bị huỷ, giữ lại cực ít máu và nhận 10 giây bất khả chiếm bại."
	]
	quest.28625E49F473135B.quest_subtitle: "★★★★"
	quest.28625E49F473135B.title: "Tinh Quang Vĩnh Cửu: Thủ Đạt Nhân"
	quest.28B79D99FF19DB3D.quest_desc: [
		"&6Nhiệm vụ: đánh bại Cảnh Tiền Tiếp Thủ"
		""
		"Trải qua chiến hoả, chịu gió cát, dù quốc gia đã diệt vong,&eCảnh Tiền Tiếp Thủ&r vẫn trấn giữ kim tự tháp này, dùng hoả khí huỷ diệt mọi kẻ địch."
		""
		"Có thể dùng&eNhãn Cát Bão&r để hồi sinh."
	]
	quest.28B79D99FF19DB3D.quest_subtitle: "Đây là Hoa Đậu Xanh à?"
	quest.28B79D99FF19DB3D.title: "Cảnh Tiền Tiếp Thủ"
	quest.28E29AA14A69F617.quest_desc: [
		"&6Quản Trị Viên Mạng Lưới Chiều Không, lén chuột phải để gắn vào mạng hiện tại."
		""
		"&6Người chơi chưa tham gia mạng chiều không gian nào có thể dùng bộ nối đã gắn để tham gia mạng này."
	]
	quest.293872FA6D26833A.quest_desc: [
		"Để triệu hồi nữ tỳ cần chuẩn bị trước các khoáng sau:"
		"&6&lLapis, Kim Cương, Thỏi Vàng, Hồng Thạch, Thỏi Sắt, Than."
		"Đứng chính diện cửa bàn tế, chuột phải lên đỉnh cột bàn tế,"
		"&atừ trái sang phải&r lần lượt cho vào theo thứ tự trên."
		"Sau khi triệu hồi thành công, giữa bàn tế sẽ xuất hiện một&ahộp quà&r；"
		"&achuột phải hộp quà ba lần&r là có được nữ tỳ của ngươi."
	]
	quest.293872FA6D26833A.quest_subtitle: "Hãy đáp lại lời ta gọi"
	quest.293872FA6D26833A.title: "Bước ba: triệu hồi nữ tỳ"
	quest.293A4F21A1CA4A9F.quest_subtitle: "Thu thập đủ nội thất Hải Long"
	quest.293A4F21A1CA4A9F.title: "Gia Trang Của Hải Long"
	quest.294DCB1F2F69927E.quest_desc: [
		"&6Nhiệm vụ: dùng Long Hồn Trống để trở lại làm người"
		""
		"&zLong Hồn&r là vật phẩm truyền thừa quan trọng nhất của long tộc. Cầm&eLong Hồn Trống&r，&dnhấn giữ chuột phải&r để&bcất con long ngươi đang điều khiển vào trong Long Hồn&r，&avà biến lại thành người&r."
		""
		"Như vậy ngươi có thể vào lại&3Hóa Long Đài&r，hoặc dùng&8Đàn Tế Long&r để hóa thành loài long khác mà&akhông lo mất tiến độ trưởng thành&r."
		""
		"Ngươi có thể nhấn&d【Shift+chuột phải】&r để&ađặt Long Hồn xuống đất&r ngắm dáng vẻ của mình；cũng có thể&dnhấn giữ chuột phải&r lần nữa để&aphục hồi trạng thái cũ&r."
		""
		"&c&lĐến đây, hướng dẫn tân thủ đã hoàn toàn kết thúc!&r Ngươi có thể trải nghiệm các loài long khác, tới&2Thế Giới Chính&r để bắt đầu phiêu lưu thật sự."
	]
	quest.294DCB1F2F69927E.quest_subtitle: "Bấm để xem chi tiết"
	quest.294DCB1F2F69927E.title: "&a&lLong Hồn Truyền Thừa"
	quest.29874A2088326B37.quest_subtitle: "Công Vẫn bay nghênh đón, đàn hạc tung tận huy quang"
	quest.29874A2088326B37.title: "&eDao Quang"
	quest.2A221FA065AEECA3.quest_desc: [
		"&6Nhiệm vụ: tìm Dư Tích Tháp Cao Cổ"
		""
		"&9La Bàn Cấu Trúc：&b【Truyền Kỳ Dị Vật】Dư Tích Tháp Cao Cổ&r"
	]
	quest.2A221FA065AEECA3.title: "Dư Tích Tháp Cao Cổ"
	quest.2A5E822D66F0BEA1.quest_desc: [
		"&l&7&rIron&5&6 pháp thuật&r&o&e và&6 sách phép thuật&r&o&e（gọi tắt: Sắt Ma Thuật）"
		""
		"&5Sắt Ma Thuật&6 là mộtmô-đun ma thuật lấy cảm hứng từ các game RPG kinh điển."
		""
		"&6Ngươi có thể chiến đấu với phù thủy nguy hiểm, giao dịch với phù thủy trung lập，"
		"&6đột nhập các công trình sinh ra tự nhiên, đào sâu địa ngục, thu thập tài nguyên，"
		"&6tìm kiếm vật phẩm phép thuật mạnh mẽ để có được và nâng cao khả năng dùng phép thuật."
		"&6Cuối cùng đánh bại&4Vương Giả Tử&6 và&cNguyên Thủ Thọ Hoả Giả&6 mạnh mẽ."
		""
		"&6gói tích hợp này thêm rất nhiều mô-đun đi kèm của Sắt Ma Thuật，"
		"&6có&aMa Thú&6 kỳ lạ đáng yêu，&dBí Thuật Đông Phương&6 mang phong cách Trung Hoa，"
		"&csách phép liên hợp Tai Biến&6，&bsách phép GTBC&6。"
		"&6Và cả mặt tối đến từ chính nội tâm ngươi: &5Song Sinh Hắc Ám"
	]
