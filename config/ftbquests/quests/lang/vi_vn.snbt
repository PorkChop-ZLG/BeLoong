	quest.5A2666846D1EFCCE.quest_desc: [
		"&6Nhiệm vụ: sau khi hiểu đặc tính của long, bấm ✅ ở góc trên trái"
		""
		"&6■Hải Long&7 là chân Long sống trong sông và biển, tuy thực lực mạnh mẽ nhưng thích điện cá.\\n\\n&2■Đặc tính:&7Ma thuật nguyên tố thuỷ, nắm quyền lôi điện, vuốt như xẻng có thể đào đất.\\n&4■Lời nguyền:&7E sợ khô han, rời nguồn nước quá lâu sẽ mất sinh lực.\\n\\n&3■Điều kiện mở khóa:&7\\n1.Hoàn thành&6Hướng dẫn tân thủ&7。&r"
	]
	quest.5A2666846D1EFCCE.quest_subtitle: "Bấm để hiểu Hải Long"
	quest.5A2666846D1EFCCE.title: "Hải Long"
	quest.5A3133909B9A3A68.quest_desc: ["Con tuyết quái khổng lồ này là thủ lĩnh của bọn chúng, là kẻ mạnh sống sót qua bao trận tranh chấp vô nghĩa. Tuy nhiên, nó không khôn hơn những con tuyết quái thường là bao."]
