	quest.1BCEED323665EDE1.quest_subtitle: "Trưởng thành tới giai đoạn Long Thái Cổ"
	quest.1BCEED323665EDE1.title: "Tuyết Nguyên Long Thái Cổ"
	quest.1C1277D37C9D79ED.quest_subtitle: "Cửu Chính Tam Uế~"
	quest.1C3B08B3C64F2810.quest_desc: [
		"&6Quản Trị Viên Mạng Lưới Chiều Không, giữ Shift và chuột phải khi cầm tay không có vật để gắn vào mạng hiện tại."
		""
		"&6Chủ động thu gom vật rơi, cầu kinh nghiệm và chất lỏng trong phạm vi nhất định. Bên trong có ô lọc dùng để lọc vật thu gom."
		""
		"&6Có thể thiết lập như sau:"
		""
		"Chế độ lọc: quyết định ô lọc coi là danh sách đen hay danh sách trắng；"
		""
		"Chế độ vật phẩm: có thu gom vật phẩm hay không；"
		""
		"Chế độ kinh nghiệm: có thu gom cầu kinh nghiệm hay không；"
		""
		"Chế độ chất lỏng: có thu gom chất lỏng hay không；"
		""
		"Chế độ NBT: có thu gom vật phẩm có NBT hay không；"
		""
		"Thiết lập phạm vi: điều chỉnh phạm vi thu gom, phạm vi càng lớn thì mỗi lần thu gom càng lâu, phạm vi tối đa là toàn bộ chunk hiện tại, tốn 1200 tick."
	]
	quest.1C637B2176DD1B81.quest_desc: [
		"&6Nhiệm vụ: đánh bại Cột Đá Hắc Diện"
		""
		"&5Cột Đá Hắc Diện&r chán Địa Đế buồn tẻ nhà chán nản, nên gọi mấy người bạn tốt tới chơi."
		""
		"{ \"text\": \"Bấm tôi để nhảy tới hướng dẫn Boss\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"196959C6E061913D\" } }"
	]
	quest.1C637B2176DD1B81.quest_subtitle: "Cái bình thường nhất"
	quest.1C637B2176DD1B81.title: "&l&5Cột Đá Hắc Diện"
	quest.1C83DAE89543CA28.quest_desc: [
		"&6Nhiệm vụ: chuột phải kích hoạt Bia Đá Dịch Chuyển trước cửa Long Cung"
		""
		"&zLong Cung&r là thành chính của bộ tích hợp này, treo cao trên chín tầng trời Thế Giới Chính, thống trị long tộc dưới trời."
		""
		"Khi bắt đầu, nơi ngươi đứng gọi là&fTiếp Dẫn Bện&r, phía trước bện là cung điện uy nghi chính là&6Long Cung&r. Trước khi hóa long, ai cũng phải tới Long Cung, bái kiến&eLong Vương&r và nhận phúc phan của Long Vương."
		""
		"Đi từng bậc thang lên, tìm&bBia Đá Dịch Chuyển&6 trước cửa Long Cung, chuột phải kích hoạt để có quyền đi lại Long Cung."
	]
	quest.1C83DAE89543CA28.quest_subtitle: "Bấm để hiểu chi tiết"
	quest.1C83DAE89543CA28.title: "Long Cung Là Gì?"
