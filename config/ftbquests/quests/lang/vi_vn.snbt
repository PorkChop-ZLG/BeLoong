	quest.21A1EB507EB2B88B.title: "Hồi 2: Hóa Long"
	quest.21CD011E6F16C411.quest_desc: [
		"&6Nhiệm vụ: đánh bại Vân Trúc Ma Tượng"
		""
		"&#A5FAFFVân Đúc Ma Tượng&r，cư ngữ tại đỉnh cao nhất của&#A5FAFFPhong Vân Thần Điện&r，dùng sức mạnh trời đất phạt người xâm nhập dám quấy rầy giấc ngủ của nó."
		""
		"Sau khi Lôi Chúa chiến tử, sinh linh Lôi Vực chỉ mong vào tượng Thánh Trời rơi xuống từ trời cao, lại đón phải mây, cuồng phong, lôi điện và laser rửa tội."
		""
		"Có thể dùng&eĐại Khí Nhãn&r để hồi sinh."
	]
	quest.21CD011E6F16C411.quest_subtitle: " mây đi đâu, gió từ đâu tới"
	quest.21CD011E6F16C411.title: "&l&#A5FAFFVân Trúc Ma Tượng"
	quest.21D5091A376C0F26.quest_desc: [
		"&l&d「Vương Giả Tử」"
		"&6Sinh lực：&a500"
		"&6Công kích：&c60"
		"&6Giáp：&715"
		""
		"&l&dSinh ra"
		"&eThi thể Vương Giả Tử&6 sẽ sinh ra trong&eMộ Môn&6，"
		"&6khi chuột phải vào thi thể, hoặc khi thi thể nhận sát thương mà xung quanh có người chơi, thi thể Vương Giả Tử sẽ phát một đoạn hoạt hình hồi sinh."
		"&6Sau khi hoạt hình kết thúc, thi thể Vương Giả Tử sẽ biến thành Vương Giả Tử."
		"&6Khi Vương Giả Tử còn sống, bầu trời thế giới sẽ chuyển xám và tầm nhìn giảm mạnh."
		"&6Khi Vương Giả Tử sinh ra, hắn cầm Thần Chúc Huyết Sắc."
		""
		"&9La Bàn Cấu Trúc：&b【Sắt Ma Thuật】Mộ Môn&r"
	]
	quest.21D5091A376C0F26.quest_subtitle: "★★★"
	quest.21D5091A376C0F26.title: "Sắt Ma Thuật: Vương Giả Tử"
	quest.21F9F82D260D81BD.quest_desc: [
		" Trong hành trình ta gặp một cự thú hình rắn, bị nhốt trong một “sân vườn” trang trí tinh xảo. Lúc đó ta chỉ nhặt một chiếc lông tơi tàn và bỏ qua những phiến vảy xanh."
		" Sự thật chứng minh những phiến vảy xanh ấy có thuộc tính ma lực phá chú thứ ta cần, nhưng ma lực quá yếu, ta cần hạ gục cự thú hình rắn kia để lấy mẫu tươi mới hơn."
	]
	quest.21F9F82D260D81BD.quest_subtitle: "&5Ta chính là chân Long"
	quest.21F9F82D260D81BD.title: "&6Ừm... huyết thống long tộc mỏng manh thế kia?"
	quest.21FA8360A0A9725F.title: "Trang Bị Băng Sương Chấp Pháp Giả"
	quest.22616810BC8A22CA.quest_subtitle: "&5&l「Mạt」&r&dMột chiếc nhẫn không gian thần kỳ"
	quest.22616810BC8A22CA.title: "Hồi 3: Tặng Vật"
	quest.226EC0050127B453.quest_desc: [
		"&6Đào&eTrứng Nhện Băng Sương&6 sẽ sinh ra&eNhện Băng Sương&6 xung quanh."
		"&6Trứng Nhện Băng Sương cần&eThu Thập Chính Xác&6 mới có được."
	]
	quest.226EC0050127B453.title: "Hạ: Nhện Băng Sương"
	quest.2280D541B1EF061F.quest_desc: [
		"&6Nhiệm vụ: nhận được thỏi thép Long Diệm"
		""
		"&cThỏi Thạch Nhiệt Tuyền + Huyết Hoả Long = Thép Long Diệm（Lò rèn Long Diệm）"
	]
	quest.2280D541B1EF061F.quest_subtitle: "Công thức đã sửa, cần thỏi Thạch Nhiệt Tuyền"
	quest.228A2960FA4D62F7.quest_desc: [
		"&l&d「Thép Trấn Giữ Giả」"
		"&6Sinh lực：&a200"
		"&6Công kích：&c60"
		"&6Giáp：&70"
		""
		"&l&dSinh ra"
		"&9La Bàn Cấu Trúc：&b【Sinh Vật Mowzie】Phòng Rèn&r"
		"{@pagebreak}"
		"&l&dHướng dẫn"
		"&cThép Trấn Giữ Giả miễn nhiễm mọi đòn tấn công ở trạng thái thường!"
		""
		"Thỉnh thoảng Thép Trấn Giữ Giả giơ đại rìu quá đầu, khoảng 1 giây sau chém dọc. Sau khi chém dọc, đại rìu cắm vào đất bị kẹt, trong 2 giây Thép Trấn Giữ Giả sẽ cố rút đại rìu ra."
		""
		"Lúc này Thép Trấn Giữ Giả&ehở điểm yếu&r, toàn bộ phía sau bất khả chiến bại được giải bỏ,&eđánh vào lưng&r sẽ gây sát thương, nhưng chỉ một lần. Sau khi gây sát thương thành công, Thép Trấn Giữ Giả sẽ cứng người khoảng 1 giây."
		""
		"&e『&6Hóa Long&e』&aĐặc biệt cải tiến&r：dùng&eChu Thiết&r có thể bỏ qua hiệu ứng bất khả chiến bại,&egây sát thương trực tiếp&r lên Thép Trấn Giữ Giả！"
	]
	quest.228A2960FA4D62F7.quest_subtitle: "★"
	quest.228A2960FA4D62F7.title: "Sinh Vật Mowzie: Thép Trấn Giữ Giả"
	quest.228FFCAF5D84CE5C.quest_desc: [
		"&6Nhiệm vụ: đánh bại Liêm Uyên Cự Long"
		""
		"&6Về sau, khe nứt chiều không gian ấy biến đổi kinh khủng, lực thối rữa bắt đầu lan sang mọi phía. Người Tinh Quang vội đóng cổng dịch chiều không gian, từ bỏ “Tháp Babel” ấy."
		"&6Từ đó, vùng đầm lầy ấy trở thành&eĐầm Lầy Tối&6 thuộc về đất cấm."
		"&6Hộ giá Tinh Quang của Chiều Tinh Quang quyết hy sinh bản thân, một mình phong ấn khe nứt chiều không gian trên đỉnh tháp."
		"&6Thời gian dài đằng đẵng trôi qua, Người Tinh Quang đã biến mất, còn người hộ giá Chiều Tinh Quang xưa kia lại sa đọa thành&eLiêm Uyên Cự Long&6 tàn nhẫn ăn thịt người."
		"{ \"text\": \"Nhảy tới hướng dẫn BOSS\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"03B1663E1AEFE3E8\" } }"
		""
		"&7&oChú ý: Liêm Uyên Cự Long không phải BOSS bản địa của Tinh Quang Vĩnh Cửu"
	]
	quest.228FFCAF5D84CE5C.quest_subtitle: "Người hộ giá Chiều Tinh Quang sa đọa"
	quest.228FFCAF5D84CE5C.title: "Liêm Uyên Cự Long"
	quest.2294D847D63E0ADE.quest_desc: [
		"&6Nhiệm vụ: quan sát Nguyên Thủ Neo 5 giây."
		""
		"&6Long tộc&r khi vào&5Địa Đế&r sẽ sinh ra trên&ebện Hắc Diện Đặc Biệt&r."
		""
		"Chuột phải&eNguyên Thủ Neo&r, ngươi sẽ được dịch tới&5Đảo Ngoài Địa Đế&r，đồng thời học được&ekỹ năng Toàn Xung&r. Ở trạng thái bay,&dbấm phím【V】&r dùng Toàn Xung, có thể tăng tốc lao về phía trước và gây sát thương."
		""
		"Nếu Nguyên Thủ Neo chưa được kích hoạt, hãy dùng&5Ngọc Trao Hư Ảnh&r chuột phải để kích hoạt."
	]
	quest.2294D847D63E0ADE.quest_subtitle: "Phúc phan cuối cùng của Ảnh Long"
	quest.2294D847D63E0ADE.title: "Nguyên Thủ Neo"
