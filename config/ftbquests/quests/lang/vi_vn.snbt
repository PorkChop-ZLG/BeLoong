	quest.77B34238D24BB235.title: "&3Học Phái Lôi Đình"
	quest.77B80117D16BB2C8.quest_desc: [
		"&6Nhiệm vụ: sau khi hiểu đặc tính của long, bấm ✅ ở góc trên trái"
		""
		"&6■Tinh Tinh Long&7 là chân Long sinh ra từ&ebụi tinh&7，vảy rồng lấp loáng&eánh sao&7，máu chảy sức mạnh của&ehạt tinh&7。\\n\\n&2■Đặc tính:&7Ma thuật không gian, tầm nhìn ban đêm vĩnh viễn, mười hai chòm sao bị động, hiệu ứng kỹ năng rực rỡ.\\n&4■Lời nguyền:&7Mất ánh sao sẽ mất sinh lực. Ngoài trời, ban đêm, trời quang thì ánh sao dồi dào; dưới lòng đất, ban ngày, mưa bão thì ánh sao nhạt nhòa.\\n\\n&3■Điều kiện mở khóa:&7\\n1.Hoàn thành&6Hướng dẫn tân thủ&7。&r"
	]
