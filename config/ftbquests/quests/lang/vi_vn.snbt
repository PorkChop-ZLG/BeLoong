	quest.21690FB87B5D206E.quest_desc: [
		"&6Nhiệm vụ ẩn: đánh bại Song Sinh Hắc Ám"
		""
		"Sau khi con người hóa long, huyết thống nhân tộc không biến mất mà ẩn sâu trong linh hồn. Khi&dNgọc Ám Ảnh&r chạm vào mặt tối sâu trong lòng, mặt người trong ngươi lại xuất hiện, ngươi sẽ tranh đấu với chính bản thân mình."
		""
		"&5Song Sinh Hắc Ám&r sẽ sao chép&btoàn bộ giáp và vũ khí&r của ngươi, đồng thời có&amáu và công kích cực cao&r được Ngọc Ám Ảnh ban cho. Ngoài ra, Nhị Thân còn biến ma thuật long tộc của ngươi thành&eSắt Ma Thuật của con người&r, đó là tuyệt kỹ mà Vương Hắc Pháp khắc vào Ngọc Ám Ảnh."
		""
		"{ \"text\": \"Bấm tôi để nhảy tới hướng dẫn Boss\", \"underlined\": true, \"color\": green, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"11FC2E4D6E6B0D93\" } }"
		""
		"&cHãy hoàn thành toàn bộ tuyến chính rồi hãy tới thử thách, nếu không ngươi sẽ không thắng được！"
	]
	quest.21690FB87B5D206E.quest_subtitle: "Nhiệm vụ ẩn"
	quest.21690FB87B5D206E.title: "&5&lSong Sinh Hắc Ám"
